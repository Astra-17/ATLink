<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Exclude generated trees before SDK globs run, including implicit None items. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;**/artifacts/**;**/bin/**;**/obj/**;.vs/**;files/**;Checks/output/**</DefaultItemExcludes>
    <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);artifacts/**;**/artifacts/**;**/bin/**;**/obj/**;.vs/**;files/**;Checks/output/**</DefaultItemExcludesInProjectFolder>
    <!-- Real builds still discover/copy all runtime data, including asset-only changes. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>
  <ItemGroup><Compile Remove="Core/**/*.cs;Checks/**/*.cs;artifacts/**/*.cs"/><ProjectReference Include="Core/ATLink.Core.csproj"/></ItemGroup>
  <ItemGroup><PackageReference Include="BCnEncoder.Net" Version="2.3.0" /></ItemGroup>
  <ItemGroup><Page Remove="artifacts/**/*.xaml"/></ItemGroup>
<ItemGroup>
  <Content Include="docs/fifarating-LICENSE.txt" Link="fifarating-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  <Content Include="docs/UTILISATION.md" Link="UTILISATION.md" CopyToOutputDirectory="PreserveNewest" />
  <Content Include="docs/PORTAGE.md" Link="PORTAGE.md" CopyToOutputDirectory="PreserveNewest" />
  <Content Include="docs/DBM-PARITY.md" Link="DBM-PARITY.md" CopyToOutputDirectory="PreserveNewest" />
  <Content Include="docs/licenses/*" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <Content Include="docs/COMPETITION-ARTWORK.md" Link="COMPETITION-ARTWORK.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <Content Include="docs/RECREATE-REF55.md" Link="RECREATE-REF55.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <Content Include="docs/COMPETITION-STUDIO.md" Link="COMPETITION-STUDIO.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <Content Include="docs/COMPETITION-PARITY.md" Link="COMPETITION-PARITY.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <Content Include="docs/PHASE-SETTINGS.md" Link="PHASE-SETTINGS.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <Content Include="files/temp.png" CopyToOutputDirectory="PreserveNewest" />
</ItemGroup>
<ItemGroup Condition="'$(DesignTimeBuild)' != 'true'">
  <Content Include="files/FC27/*.db;files/FC27/*-meta.xml" Link="Data/FC27/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <Content Include="files/FC27/LIVE_EDITOR_LIMITS.json" Link="Data/FC27/LIVE_EDITOR_LIMITS.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <Content Include="files/FC27/loc/*.db;files/FC27/loc/*-meta.xml" Link="Data/FC27/loc/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <Content Include="files/FC27/compdata/**/*" Link="Data/FC27/compdata/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <Content Include="files/fifa_ng_db.db;files/fifa_ng_db-meta.xml;files/eng_us.db;files/eng_us-meta.xml;files/fre_fr.db;files/fre_fr-meta.xml;files/FC26_NATIONAL_TEAM_IDS.csv" Link="Data/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
</ItemGroup>
<ItemGroup Condition="'$(DesignTimeBuild)' != 'true'">
  <Content Include="files/head/**/*.png" Link="Data/head/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <Content Include="files/crest/**/*.png" Link="Data/crest/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
</ItemGroup>
<ItemGroup Condition="'$(DesignTimeBuild)' != 'true'"><Content Include="files/flags/**/*.png" Link="Data/flags/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup><ItemGroup Condition="'$(DesignTimeBuild)' != 'true'"><Content Include="files/players_enrich.json" Link="Data/players_enrich.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
