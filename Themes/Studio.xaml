 <Style TargetType="Window">
  <Setter Property="Icon" Value="/ATLink;component/Resource/ATLink.png"/>
  <Setter Property="WindowStyle" Value="None"/>
  <Setter Property="views:WindowAppearance.Enabled" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Window">
   <Border x:Name="WindowFrame" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{TemplateBinding Background}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Background="{StaticResource TitleBarBrush}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <DockPanel Margin="12,0" VerticalAlignment="Center"><Image DockPanel.Dock="Left" Source="{TemplateBinding Icon}" Width="24" Height="24" Margin="0,0,8,0"/><TextBlock Text="{TemplateBinding Title}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <Button x:Name="Settings" Style="{StaticResource WindowCaptionButton}" Content="⚙" FontSize="18" Command="{Binding Path=(views:WindowAppearance.SettingsCommand), RelativeSource={RelativeSource TemplatedParent}}" ToolTip="{loc:Text T28c83220eb3316}" AutomationProperties.Name="{loc:Text T28c83220eb3316}"/>
       <Button x:Name="Minimize" Style="{StaticResource WindowCaptionButton}" Command="{x:Static SystemCommands.MinimizeWindowCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" ToolTip="{loc:Text Td72e311c4ddaf4}" AutomationProperties.Name="{loc:Text Td72e311c4ddaf4}">
        <Path Data="M 0,0 L 10,0" Stroke="{StaticResource TextBrush}" StrokeThickness="1"/>
       </Button>
       <Button x:Name="Maximize" Style="{StaticResource WindowCaptionButton}" Command="{x:Static SystemCommands.MaximizeWindowCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" ToolTip="{loc:Text Tf4f76fec5a93da}" AutomationProperties.Name="{loc:Text T9e47a676743f68}">
        <Path x:Name="MaxIcon" Data="M 0,0 L 10,0 10,10 0,10 Z" Stroke="{StaticResource TextBrush}" StrokeThickness="1"/>
       </Button>
       <Button Style="{StaticResource WindowCloseButton}" Command="{x:Static SystemCommands.CloseWindowCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" ToolTip="{loc:Text T7d9eb7acb13e24}" AutomationProperties.Name="{loc:Text T7d9eb7acb13e24}">
        <Path Data="M 0,0 L 10,10 M 0,10 L 10,0" Stroke="{StaticResource TextBrush}" StrokeThickness="1"/>
       </Button>
      </StackPanel>
     </Grid>
     <AdornerDecorator Grid.Row="1"><ContentPresenter/></AdornerDecorator>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="views:WindowAppearance.SettingsCommand" Value="{x:Null}"><Setter TargetName="Settings" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="ResizeMode" Value="NoResize"><Setter TargetName="Minimize" Property="Visibility" Value="Collapsed"/><Setter TargetName="Maximize" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="ResizeMode" Value="CanMinimize"><Setter TargetName="Maximize" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="WindowState" Value="Maximized"><Setter TargetName="WindowFrame" Property="BorderThickness" Value="0"/><Setter TargetName="MaxIcon" Property="Data" Value="M 2,0 L 10,0 10,8 M 0,2 L 8,2 8,10 0,10 Z"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
