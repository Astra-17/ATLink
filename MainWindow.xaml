<Window Style="{DynamicResource {x:Type Window}}" x:Class="ATLink.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding WindowTitle}" Width="1400" Height="850" MinWidth="960" MinHeight="580" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource BackgroundBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="HomeScreen" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Screen}" Value="Home"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="EditingScreen" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Screen}" Value="Editing"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="LauncherScreen" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Screen}" Value="Launcher"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="TableScreen" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Screen}" Value="Tables"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="PageScreen" TargetType="ContentControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Screen}" Value="Page"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
 </ResourceDictionary></Window.Resources>
 <Grid Background="{StaticResource BackgroundBrush}">
  <Grid Style="{StaticResource EditingScreen}" Background="{DynamicResource HomeBackgroundBrush}">
   <Button Content="Competition editing" Click="CompdataClick" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24"/>
   <Button Content="⚙  System" Click="SettingsClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24" AutomationProperties.Name="System settings"/>
   <StackPanel MaxWidth="860" Margin="30" VerticalAlignment="Center">
    <TextBlock Text="Choose a database" FontSize="30" FontWeight="Bold" Margin="0,0,0,26"/>
    <UniformGrid Columns="2">
     <Button x:Name="BaseDbButton" Style="{StaticResource HomeCardButton}" BorderBrush="{DynamicResource HomeCardBorderBrush}" Margin="0,0,12,0" Click="BaseDbClick"><StackPanel><TextBlock Text="Base DB" FontSize="24" FontWeight="Bold"/><TextBlock Text="Open the included database" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel></Button>
     <Button x:Name="SelectedDbButton" Style="{StaticResource HomeCardButton}" BorderBrush="{DynamicResource HomeCardBorderBrush}" Click="SquadClick"><StackPanel><TextBlock Text="Selected DB" FontSize="24" FontWeight="Bold"/><TextBlock Text="Choose a Squad file" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel></Button>
    </UniformGrid>
   </StackPanel>
  </Grid>
  <!-- Project launcher -->
  <Grid Style="{StaticResource LauncherScreen}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="{DynamicResource HeaderBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12"><DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Close" Click="CloseClick" Margin="0,0,6,0"/><Button Content="DB" Click="EditingClick" Margin="0,0,6,0"/><Button Background="{DynamicResource AccentBrush}" Content="Save" Click="SaveClick" ToolTip="Save as a new DB file"/></StackPanel>
    <StackPanel Orientation="Horizontal"><Border Width="38" Height="38" Background="{StaticResource AccentBrush}" CornerRadius="8" Margin="0,0,12,0"><TextBlock Text="ATL" Foreground="White" FontWeight="ExtraBold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="ATLink Studio" FontSize="18" FontWeight="Bold"/><TextBox Style="{StaticResource DocumentNameBox}" Text="{Binding DocumentTitle, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding DocumentTitleLocked}"/></StackPanel></StackPanel>
   </DockPanel></Border>
   <StackPanel Grid.Row="1" Margin="22">
    <UniformGrid Columns="2" Margin="0,0,0,18"><Button Style="{StaticResource HomeCardButton}" MinHeight="88" BorderBrush="{DynamicResource LineBrush}" Margin="0,0,12,0" Command="{Binding ShowTablesCommand}"><StackPanel><TextBlock Text="Table Editor" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding TableCount, StringFormat={}{0} tables}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Button><Button Style="{StaticResource HomeCardButton}" MinHeight="88" BorderBrush="{DynamicResource LineBrush}" Click="ModulesClick" ToolTipService.ShowOnDisabled="True" ToolTip="Open players, teams, leagues and transfers"><StackPanel><TextBlock Text="Modules" FontSize="18" FontWeight="Bold"/><TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"><Run Text="{Binding PlayersCount, Mode=OneWay}"/><Run Text=" players / "/><Run Text="{Binding TeamsCount, Mode=OneWay}"/><Run Text=" teams / "/><Run Text="{Binding LeaguesCount, Mode=OneWay}"/><Run Text=" leagues"/></TextBlock></StackPanel></Button></UniformGrid>
    <UniformGrid Columns="5"><Button Style="{StaticResource ModuleCard}" Click="ModulesClick" Tag="players"><StackPanel><TextBlock Text="Players" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding PlayersCount}" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel></Button><Button Style="{StaticResource ModuleCard}" Click="ModulesClick" Tag="teams"><StackPanel><TextBlock Text="Teams" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding TeamsCount}" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel></Button><Button Style="{StaticResource ModuleCard}" Click="ModulesClick" Tag="leagues"><StackPanel><TextBlock Text="Leagues" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding LeaguesCount}" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel></Button><Button Style="{StaticResource ModuleCard}" Click="ModulesClick" Tag="transfers"><StackPanel><TextBlock Text="Transfers" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding TransfersCount}" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel></Button><Button Style="{StaticResource ModuleCard}" Margin="0" Click="ModulesClick" Tag="stadiums"><StackPanel><TextBlock Text="Stadiums" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding StadiumsCount}" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel></Button></UniformGrid>
   </StackPanel>
   <Border Grid.Row="2" Background="{DynamicResource StatusBarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,9"><TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></Border>
  </Grid>
  <!-- Table workspace -->
  <Grid Style="{StaticResource TableScreen}"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource RailBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0"><DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16"><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" Background="{StaticResource AccentBrush}" CornerRadius="8" Margin="0,0,10,0"><TextBlock Text="ATL" Foreground="White" FontWeight="ExtraBold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center" Width="192"><TextBlock Text="ATLink Studio" FontSize="18" FontWeight="Bold"/><TextBox Style="{StaticResource DocumentNameBox}" Text="{Binding DocumentTitle, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding DocumentTitleLocked}"/></StackPanel></StackPanel></Border>
    <Grid DockPanel.Dock="Top" Margin="12"><TextBox Height="38" Text="{Binding TableFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}" ToolTip="Filter tables"/><TextBlock Text="Filter tables" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TableFilter}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <ListBox ItemsSource="{Binding FilteredTables}" SelectedItem="{Binding SelectedTable}" Background="Transparent" BorderThickness="0" Margin="8,0,8,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding RowCount}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource HeaderBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,7"><WrapPanel>
     <Button Style="{StaticResource ToolButton}" Content="Players" Click="PlayersHomeClick"/><Button Style="{StaticResource ToolButton}" Content="Modules" Click="ModulesClick"/>
     <Border Width="1" Height="22" Background="{StaticResource LineBrush}" Margin="3,4,9,0"/>
     <Button Style="{StaticResource ToolButton}" Content="DB" Click="EditingClick"/><Button Style="{StaticResource ToolButton}" Content="Squad" Click="SquadClick"/><Button Style="{StaticResource ToolButton}" Content="Hash" Click="HashClick"/><Button Style="{StaticResource ToolButton}" Content="LOC" Click="LocalizationClick"/><Button Style="{StaticResource ToolButton}" Content="BIG" Click="BigClick"/><Border Width="1" Height="22" Background="{StaticResource LineBrush}" Margin="3,4,9,0"/>
     <Button Style="{StaticResource ToolButton}" Content="Save" Click="SaveClick" ToolTip="Save as a new DB file"/><Button Style="{StaticResource ToolButton}" Content="Export" Click="ExportClick"/><Button Style="{StaticResource ToolButton}" Content="Export+" Click="ExportAllClick"/><Button Style="{StaticResource ToolButton}" Content="Import" Click="ImportClick"/><Button Style="{StaticResource ToolButton}" Content="Import+" Click="ImportAllClick"/>
     <Border Width="1" Height="22" Background="{StaticResource LineBrush}" Margin="3,4,9,0"/>
     <Button Style="{StaticResource ToolButton}" Content="New" Click="NewClick"/><Button Style="{StaticResource ToolButton}" Content="Copy" Click="CopyClick"/><Button Style="{StaticResource ToolButton}" Content="Paste" Click="PasteClick"/><Button Style="{StaticResource ToolButton}" Content="Replace" Click="ReplaceClick"/><Button Style="{StaticResource ToolButton}" Content="Delete" Click="DeleteClick"/><Button Style="{StaticResource ToolButton}" Content="Count" Click="CountClick"/><Button Style="{StaticResource ToolButton}" Content="Undo" Click="RevertClick" ToolTip="Discard all changes"/>
    </WrapPanel></Border>
    <Border Grid.Row="1" Background="{DynamicResource HeaderBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,8"><WrapPanel>
     <ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding SearchColumn}" Width="190" Margin="0,0,6,0"/>
     <Button Content="Go to column" Click="GoToColumnClick" Margin="0,0,6,0"/>
     <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Width="220" ToolTip="Search" Margin="0,0,6,0"/>
     <CheckBox Content="Exact match" IsChecked="{Binding ExactMatch}" VerticalAlignment="Center" Margin="4,0,10,0"/>
     <Button Content="Find" Click="FindClick" Margin="0,0,6,0"/><TextBlock Text="{Binding FieldInfo}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
    </WrapPanel></Border>
    <DataGrid Grid.Row="2" x:Name="TableGrid" ItemsSource="{Binding GridRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Sorting="GridSorting" CanUserSortColumns="True" SelectionMode="Extended" SelectionUnit="FullRow" ClipboardCopyMode="IncludeHeader" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" BorderThickness="0" RowHeight="30" ColumnHeaderHeight="30" ColumnWidth="132" MinColumnWidth="80" RowBackground="{DynamicResource PanelBrush}" Background="{DynamicResource PanelBrush}" HorizontalGridLinesBrush="{StaticResource LineBrush}" VerticalGridLinesBrush="{StaticResource LineBrush}" GridLinesVisibility="All" HeadersVisibility="Column"/>
    <Border Grid.Row="3" Background="{DynamicResource StatusBarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,8"><DockPanel><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button Content="Prev" Command="{Binding PreviousCommand}"/><TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Margin="8,0"/><Button Content="Next" Command="{Binding NextCommand}" Margin="0,0,6,0"/><ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Width="68"/></StackPanel><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Margin="16,0,0,0"/></DockPanel></Border>
   </Grid>
  </Grid>
  <ContentControl Style="{StaticResource PageScreen}" Content="{Binding Page}"/>
  <Border Background="{DynamicResource LoadingOverlayBrush}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"><Border Background="{DynamicResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Width="360" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Loading database" FontSize="15" FontWeight="Bold"/><TextBlock Text="Reading tables and decoding names…" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,16"/><ProgressBar IsIndeterminate="True" Height="5" Foreground="{StaticResource AccentBrush}"/></StackPanel></Border></Border>
 </Grid>
</Window>








