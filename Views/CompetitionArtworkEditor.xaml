<UserControl xmlns:loc="clr-namespace:ATLink.Services" x:Class="ATLink.Views.CompetitionArtworkEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
 <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource PanelBrush}" Padding="16" Margin="0,12">
 <StackPanel><TextBlock Text="{loc:Text T7831ec40445cc5}" FontSize="21" FontWeight="SemiBold"/>
  <TextBlock Text="{loc:Text T61b54f861bfc73}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14"/>
  <TextBlock Text="{loc:Text T1dfc14a89856bb}" FontWeight="SemiBold"/>
  <Border Background="#292237" CornerRadius="4" HorizontalAlignment="Left" Width="148" Height="148" Margin="0,8"><Image Source="{Binding LogoPreview}" Stretch="Uniform" Margin="6"/></Border>
  <Button Content="{loc:Text Tc3d75e027cb5c0}" Click="ImportLogo" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Left"/>
  <TextBlock Text="{loc:Text T2384a255193c63}" FontWeight="SemiBold" Margin="0,18,0,0"/>
  <Border Background="#292237" CornerRadius="4" HorizontalAlignment="Stretch" Height="110" Margin="0,8"><Image Source="{Binding TitlePreview}" Stretch="Uniform" Margin="6"/></Border>
  <Button Content="{loc:Text Ta8f752b3bf50a2}" Click="ImportTitle" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Left"/>
  <TextBlock Text="{loc:Text Tf6cdb21335aa85}" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,6"/>
  <Border Background="#292237" HorizontalAlignment="Left" Width="200" Height="64"><Image Source="{Binding TinyPreview}" Stretch="None"/></Border>
  <ProgressBar Value="{Binding Progress,Mode=OneWay}" Maximum="100" Height="6" Margin="0,12" Visibility="{Binding Busy,Converter={StaticResource Visible}}"/>
  <Button Content="{loc:Text Tc1a56cf73ef889}" Click="CancelProcessing" HorizontalAlignment="Left" Visibility="{Binding Busy,Converter={StaticResource Visible}}"/>
  <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,6"/>
  <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,4"/>
  <WrapPanel><Button Content="{loc:Text Tf47b31b00a408d}" Click="Remove" IsEnabled="{Binding CanEdit}" Margin="0,4,8,0"/><Button Content="{loc:Text T5da3376309ca68}" Click="Discard" IsEnabled="{Binding CanEdit}" Margin="0,4,8,0"/><Button Content="{loc:Text T80838a83197b54}" Click="Apply" IsEnabled="{Binding CanEdit}" Visibility="{Binding Existing,Converter={StaticResource Visible}}" Margin="0,4,0,0"/></WrapPanel>
 </StackPanel></Border>
</UserControl>
