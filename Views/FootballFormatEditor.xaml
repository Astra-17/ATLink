<UserControl x:Class="ATLink.Views.FootballFormatEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ATLink.Views">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/><Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,12,0,5"/><Setter Property="FontWeight" Value="SemiBold"/></Style></UserControl.Resources>
 <StackPanel>
 <local:CompetitionArtworkEditor DataContext="{Binding Artwork}"><local:CompetitionArtworkEditor.Style><Style TargetType="local:CompetitionArtworkEditor"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CreationFlow,RelativeSource={RelativeSource AncestorType=local:FootballFormatEditor}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:CompetitionArtworkEditor.Style></local:CompetitionArtworkEditor>
 <TextBlock Text="The competition path" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
 <ItemsControl ItemsSource="{Binding Phases}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8"><DockPanel><WrapPanel DockPanel.Dock="Right"><Button IsEnabled="{Binding Editable}" Content="Edit" Click="Edit" Margin="3"/><Button Content="Rules" Click="Rules" Margin="3"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CreationFlow,RelativeSource={RelativeSource AncestorType=local:FootballFormatEditor}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="↑" Click="Up" Margin="3"/><Button Content="↓" Click="Down" Margin="3"/><Button Visibility="{Binding CanRemove,Converter={StaticResource Visible}}" Content="Remove" Click="Remove" Margin="3"/></WrapPanel><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding EssentialsSummary}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding CreationFlow,RelativeSource={RelativeSource AncestorType=local:FootballFormatEditor}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><WrapPanel Margin="0,10,0,0" IsEnabled="{Binding Editable}">
<StackPanel Width="130" Margin="0,0,12,0"><TextBlock Text="Teams"/><ComboBox ItemsSource="{Binding ParticipantChoices}" SelectedItem="{Binding Participants}" IsEnabled="{Binding CanChooseInput}"/></StackPanel>
<StackPanel Width="110" Margin="0,0,12,0" Visibility="{Binding IsGroups,Converter={StaticResource Visible}}"><TextBlock Text="Groups"/><ComboBox ItemsSource="{Binding GroupChoices}" SelectedItem="{Binding Groups}"/></StackPanel>
<StackPanel Width="160" Margin="0,0,12,0" Visibility="{Binding Tables,Converter={StaticResource Visible}}"><TextBlock Text="Qualifiers per group"/><ComboBox ItemsSource="{Binding QualifierChoices}" SelectedItem="{Binding Qualifiers}"/></StackPanel>
<StackPanel Width="110" Margin="0,0,12,0" Visibility="{Binding Knockout,Converter={StaticResource Visible}}"><TextBlock Text="Rounds"/><ComboBox ItemsSource="{Binding RoundChoices}" SelectedItem="{Binding Rounds}"/></StackPanel>
<StackPanel Width="160"><TextBlock Text="Matches"/><ComboBox ItemsSource="{Binding LegOptions}" SelectedItem="{Binding Legs}"/></StackPanel>
</WrapPanel></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <Button Content="+ Add a phase" Click="AddPhase" HorizontalAlignment="Left" Margin="0,4,0,16"/>
 <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,14"/>
 <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Margin="0,10"/>
 <StackPanel Visibility="{Binding Existing,Converter={StaticResource Visible}}"><Button Content="Preview changes" Click="Preview" HorizontalAlignment="Left" Margin="0,6"/><CheckBox Content="I have reviewed the changes to the competition path and matchdays" IsChecked="{Binding ConfirmChanges}" Visibility="{Binding RequiresConfirmation,Converter={StaticResource Visible}}" Margin="0,8"/><Button Content="Apply format" Click="Apply" HorizontalAlignment="Left" Margin="0,8"/></StackPanel>
 </StackPanel>
</UserControl>
