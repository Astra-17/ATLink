<UserControl xmlns:loc="clr-namespace:ATLink.Services" x:Class="ATLink.Views.FootballSettingsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel Margin="14"><TextBlock Text="{loc:Text Tde02ea255ba66b}" FontSize="26" FontWeight="Bold"/><TextBlock Text="{loc:Text T7f0e698002c8ee}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,20"/>
<ItemsControl x:Name="Cards"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="18" Margin="0,0,0,18"><StackPanel><DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="{loc:Text Tb435d70092056f}" Click="AddOption" Padding="14,8" Background="{DynamicResource AccentBrush}"/><StackPanel><TextBlock Text="{Binding Phase.Name}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding Phase.Summary}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></DockPanel>
<Button Content="{loc:Text Tee8e7bf449a6f4}" Click="EditEssentials" HorizontalAlignment="Left" Margin="0,0,0,10"/><TextBlock Text="{Binding Phase.EssentialsSummary}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding Options}"><ItemsControl.ItemTemplate><DataTemplate><Button Click="EditOption" HorizontalContentAlignment="Stretch" Margin="0,3" Padding="12" Tag="{Binding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Origin}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding EmptyMessage}" Foreground="{DynamicResource MutedBrush}" Margin="0,8"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/></StackPanel></UserControl>