<UserControl x:Class="ATLink.Views.CompetitionBrowser" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <DockPanel Margin="0,0,20,0"><TextBlock DockPanel.Dock="Top" Text="Competitions" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/><TextBox DockPanel.Dock="Top" x:Name="Search" TextChanged="SearchChanged" ToolTip="Search competitions by name" Margin="0,0,0,12"/><ListBox x:Name="Competitions" DisplayMemberPath="DisplayName" SelectionChanged="Selected"/></DockPanel>
 <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
 <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="20"><StackPanel><TextBlock x:Name="Title" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="Summary" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,14" TextWrapping="Wrap"/><Button Content="Advanced competition rules" HorizontalAlignment="Left" Click="EditRules"/><Expander Header="Change display name" Margin="0,14,0,0"><StackPanel><TextBlock Text="Enter a custom name. Applying replaces this competition's description in the exported Compdata." TextWrapping="Wrap" Margin="0,8"/><TextBox x:Name="CustomName"/><Button Content="Apply name" Click="Rename" HorizontalAlignment="Left" Margin="0,8"/></StackPanel></Expander></StackPanel></Border>
 <TextBlock Text="Competition structure" FontSize="20" FontWeight="Bold" Margin="0,22,0,10"/><TextBlock Text="Stages contain the groups in which teams play. Select a stage or group to edit its rules." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/><TreeView x:Name="Structure" MinHeight="220"/>
 <TextBlock Text="Main rules" FontSize="20" FontWeight="Bold" Margin="0,22,0,10"/><StackPanel x:Name="Rules"/><Button Content="Apply main rules" Click="ApplyRules" HorizontalAlignment="Left" Margin="0,12"/><TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,16"/>
 </StackPanel></ScrollViewer></Grid>
</UserControl>
