<UserControl xmlns:loc="clr-namespace:ATLink.Services" x:Class="ATLink.Views.CompetitionLogoOverview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources>
  <DataTemplate x:Key="Preview">
   <Grid><Image Source="{Binding}" Stretch="Uniform"/><TextBlock Text="{loc:Text T05371499f9fb4e}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
  </DataTemplate>
 </UserControl.Resources>
 <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
  <StackPanel><TextBlock Text="{loc:Text T819f6d0d964091}" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <WrapPanel>
    <StackPanel Margin="0,0,20,12"><TextBlock Text="{loc:Text T8217293a96bbd5}" Margin="0,0,0,8"/><ContentControl Width="200" Height="200" Content="{Binding OverviewLogo}" ContentTemplate="{StaticResource Preview}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></StackPanel>
    <StackPanel Margin="0,0,20,12"><TextBlock Text="{loc:Text T30b0f8fc0ea4f4}" Margin="0,0,0,8"/><ContentControl Width="128" Height="128" Content="{Binding OverviewSmallLogo}" ContentTemplate="{StaticResource Preview}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></StackPanel>
    <StackPanel Margin="0,0,0,12"><TextBlock Text="{loc:Text T78ff1a9a8bb159}" Margin="0,0,0,8"/><ContentControl Width="200" Height="64" Content="{Binding OverviewTinyLogo}" ContentTemplate="{StaticResource Preview}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></StackPanel>
   </WrapPanel>
  </StackPanel>
 </Border>
</UserControl>
