<UserControl Foreground="{DynamicResource TextBrush}" x:Class="ATLink.Views.ModulesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ATLink.Views" Background="{DynamicResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries><views:EntityImageConverter x:Key="EntityImageConverter"/></ResourceDictionary></UserControl.Resources>
 <DockPanel Background="{DynamicResource BackgroundBrush}"><Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Change DB" Click="HomeClick" Margin="0,0,6,0"/><Button Content="Tables" Click="TablesClick" Margin="0,0,6,0"/><Button Content="Settings" Click="SettingsClick" Margin="0,0,6,0"/><Button Content="Save" Click="SaveClick"/></StackPanel><StackPanel><TextBlock Text="ATLink Studio" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="Subtitle" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DockPanel></Border>
 <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" Padding="16,9" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"><TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></Border>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="10"><StackPanel x:Name="ModuleNavigation"><Button Content="Players" Tag="players" Click="ModuleClick" Height="48" Margin="0,0,0,6"/><Button Content="Teams" Tag="teams" Click="ModuleClick" Height="48" Margin="0,0,0,6"/><Button Content="Leagues" Tag="leagues" Click="ModuleClick" Height="48" Margin="0,0,0,6"/><Button Content="Transfers" Tag="transfers" Click="ModuleClick" Height="48" Margin="0,0,0,6"/><Button Content="Stadiums" Tag="stadiums" Click="ModuleClick" Height="48"/></StackPanel></Border>
 <DockPanel Grid.Column="1" Margin="18"><StackPanel x:Name="ModuleHeader" DockPanel.Dock="Top"><TextBlock Text="Module" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock x:Name="ModuleTitle" Text="Players" FontSize="24" FontWeight="Bold" Margin="0,2,0,12"/><WrapPanel Margin="0,0,0,14"><TextBox x:Name="Search" Width="320" ToolTip="Search by name or ID" TextChanged="SearchChanged" Margin="0,0,8,0"/><Button Content="Edit" Click="EditClick" Margin="0,0,8,0"/><Button x:Name="CreateButton" Content="Create from selected" Click="CreateClick" Margin="0,0,8,0"/><Button x:Name="FormationButton" Content="Formation" Click="FormationClick" Margin="0,0,8,0"/><Button x:Name="RelatedButton" Content="Related records" Click="RelatedClick"/></WrapPanel></StackPanel>
 <Grid><ContentControl x:Name="PlayerContent" Visibility="Collapsed"/><ListBox x:Name="Results" Background="Transparent" BorderThickness="0" MouseDoubleClick="EditDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/><Border Width="65" Height="65" CornerRadius="8" Background="{DynamicResource RailBrush}" DockPanel.Dock="Left" Margin="0,0,12,0"><Image Source="{Binding Converter={StaticResource EntityImageConverter}}" Stretch="Uniform" Margin="4"/></Border><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Id, StringFormat=ID {0}}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
 </DockPanel></Grid></DockPanel>
</UserControl>




