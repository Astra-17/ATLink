<UserControl x:Class="ATLink.Views.CompetitionCreationWizard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource BackgroundBrush}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries><Style TargetType="DatePickerTextBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource PanelBrush}"/></Style><Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,16,0,6"/><Setter Property="FontWeight" Value="SemiBold"/></Style></ResourceDictionary></UserControl.Resources>
 <DockPanel Margin="22"><TextBlock DockPanel.Dock="Top" Text="Create a competition" FontSize="28" FontWeight="Bold" Margin="0,0,0,16"/><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding CreationError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,12"/><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Cancel" Click="Cancel" Margin="4"/><Button Content="Previous" Click="Previous" Margin="4"/><Button Content="Next" Click="Next" Margin="4"/><Button Content="Create project draft" Click="Create" Background="{DynamicResource AccentBrush}" Margin="4"/></StackPanel><TextBlock x:Name="StepLabel" VerticalAlignment="Center"/></DockPanel></StackPanel>
 <TabControl x:Name="Steps" SelectionChanged="StepChanged">
 <TabItem Header="1 · Template"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22"><TextBlock Text="Choose an existing competition as a database template. Its presentation settings are copied; its domestic club memberships are not moved." TextWrapping="Wrap"/><TextBlock Text="Compatible templates" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding Template}" DisplayMemberPath="DisplayName"/><CheckBox Content="Copy the existing format, teams, rules and calendar" IsChecked="{Binding CopyTemplate}" Margin="0,20"/><TextBlock Text="Uncheck this option to build a custom format in steps 3-7. In copy mode, edit participants and rules after creation." TextWrapping="Wrap"/><TextBlock Text="The new competition gets separate IDs. Graphics and career integration may need additional game resources." TextWrapping="Wrap" Margin="0,20"/></StackPanel></ScrollViewer></TabItem>
 <TabItem Header="2 · Identity"><StackPanel Margin="22"><TextBlock Text="Competition name" Style="{StaticResource Label}"/><TextBox Text="{Binding NewName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="The country or region is inherited from the selected template. Technical codes and free IDs are allocated automatically." TextWrapping="Wrap" Margin="0,20"/></StackPanel></TabItem>
 <TabItem Header="3 · Format" IsEnabled="{Binding BuildNewFormat}"><StackPanel Margin="22"><TextBlock Text="Format" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding NewFormat}"/><TextBlock Text="Number of groups (1 for a league or cup)" Style="{StaticResource Label}"/><TextBox Text="{Binding NewGroups,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Teams per group (2, 4, 8, 16… for a cup)" Style="{StaticResource Label}"/><TextBox Text="{Binding NewSize,UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Home and away matches for leagues/groups" IsChecked="{Binding ReturnLegs}" Margin="0,20"/></StackPanel></TabItem>
 <TabItem Header="4 · Participants" IsEnabled="{Binding BuildNewFormat}"><Grid Margin="22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><DockPanel Margin="0,0,12,0"><TextBlock DockPanel.Dock="Top" Text="Find clubs" Style="{StaticResource Label}"/><TextBox DockPanel.Dock="Top" Text="{Binding TeamSearch,UpdateSourceTrigger=PropertyChanged}"/><Button DockPanel.Dock="Bottom" Content="Add selected club →" Click="AddTeam" Margin="0,10"/><ListBox ItemsSource="{Binding AvailableTeams}" SelectedItem="{Binding NewTeamSelection}" DisplayMemberPath="Name" VirtualizingPanel.IsVirtualizing="True"/></DockPanel><DockPanel Grid.Column="1"><TextBlock DockPanel.Dock="Top" Text="Selected participants" Style="{StaticResource Label}"/><TextBlock DockPanel.Dock="Top" Text="Fill every place, or leave this empty to configure dynamic team sources after creation." TextWrapping="Wrap"/><Button DockPanel.Dock="Bottom" Content="Remove selected club" Click="RemoveTeam" Margin="0,10"/><ListBox ItemsSource="{Binding NewTeams}" SelectedItem="{Binding RemoveTeamSelection}" DisplayMemberPath="Name"/></DockPanel></Grid></TabItem>
 <TabItem Header="5 · Qualifications" IsEnabled="{Binding BuildNewFormat}"><StackPanel Margin="22"><TextBlock Text="Cup winners progress automatically until the final. Leagues and group competitions can add a knockout phase below, or use dynamic qualifiers configured in Format &amp; qualification after creation." TextWrapping="Wrap"/><CheckBox Content="Add knockout rounds after the league/group stage" IsChecked="{Binding NewKnockout}" Margin="0,20"/><TextBlock Text="Qualifiers per group (total must be 2, 4, 8, 16…)" Style="{StaticResource Label}"/><TextBox Text="{Binding NewQualifiers,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></TabItem>
 <TabItem Header="6 · Calendar" IsEnabled="{Binding BuildNewFormat}"><StackPanel Margin="22"><TextBlock Text="First match in the illustrative reference season" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding NewDate}"/><TextBlock Text="Days between matchdays" Style="{StaticResource Label}"/><TextBox Text="{Binding NewInterval,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Kick-off time" Style="{StaticResource Label}"/><TextBox Text="{Binding NewTime,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Dates are generated relative to the project's reference season. Confirm their conversion against the game before distributing the competition." TextWrapping="Wrap" Margin="0,20"/></StackPanel></TabItem>
 <TabItem Header="7 · Rules" IsEnabled="{Binding BuildNewFormat}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22"><TextBlock Text="Players on the bench" Style="{StaticResource Label}"/><TextBox Text="{Binding NewBench,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Substitutions" Style="{StaticResource Label}"/><TextBox Text="{Binding NewSubs,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Points for a win" Style="{StaticResource Label}"/><TextBox Text="{Binding NewWin,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Points for a draw" Style="{StaticResource Label}"/><TextBox Text="{Binding NewDraw,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Points for a defeat" Style="{StaticResource Label}"/><TextBox Text="{Binding NewLoss,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></ScrollViewer></TabItem>
 <TabItem Header="8 · Review"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22"><TextBlock Text="Review before creating" FontSize="22" FontWeight="Bold"/><Button Content="Refresh preview" Click="Preview" HorizontalAlignment="Left" Margin="0,15"/><TextBlock Text="{Binding CreationPreview}" TextWrapping="Wrap"/><TextBlock Text="Creation stays in the project draft. Export a new project folder when ready; then install and test it with the game's editing tools." TextWrapping="Wrap" Margin="0,20"/></StackPanel></ScrollViewer></TabItem>
 </TabControl></DockPanel>
</UserControl>
