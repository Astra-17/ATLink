<UserControl x:Class="ATLink.Views.FootballMatchupsEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="Source"><StackPanel Orientation="Horizontal"><Image Source="{Binding Crest}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,6,0"/><TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding Label,Mode=OneWay}"/><Run Text="{Binding IdCaption,Mode=OneWay}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></TextBlock></StackPanel></DataTemplate>
  <Style x:Key="SourceBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="ItemTemplate" Value="{StaticResource Source}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><DataTrigger Binding="{Binding Valid}" Value="False"><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/></DataTrigger></Style.Triggers></Style>
 </ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock Text="Matchups" FontSize="25" FontWeight="Bold"/><TextBlock Text="Choose the pairings for every knockout round. Group places and future winners remain qualification rules." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,16"/>
 <WrapPanel><StackPanel Width="210" Margin="0,0,12,8"><TextBlock Text="Model"/><ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"/></StackPanel><StackPanel Width="170" Margin="0,0,12,8"><TextBlock Text="Draw seed"/><TextBox Text="{Binding Seed,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DrawSelected}"/></StackPanel><Button Content="Apply model" Click="ApplyModel" IsEnabled="{Binding CanApply}" Background="{DynamicResource AccentBrush}" Margin="0,16,12,8"/><Button Content="Undo" Click="Undo" IsEnabled="{Binding CanUndo}" Margin="0,16,6,8"/><Button Content="Redo" Click="Redo" IsEnabled="{Binding CanRedo}" Margin="0,16,0,8"/></WrapPanel>
 <TextBlock Text="{Binding ModelNote}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,8"/><TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" Margin="0,4,0,12"/>
 <ItemsControl ItemsSource="{Binding Rounds}"><ItemsControl.ItemTemplate><DataTemplate><Expander Header="{Binding Name}" IsExpanded="True" Margin="0,6,0,14"><StackPanel><TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="6,6"/><ItemsControl ItemsSource="{Binding Ties}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4"><StackPanel><TextBlock Text="{Binding Title}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,7"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox DataContext="{Binding Home}" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" Style="{StaticResource SourceBox}" VirtualizingPanel.IsVirtualizing="True"/><TextBlock Grid.Column="1" Text="vs" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><ComboBox Grid.Column="2" DataContext="{Binding Away}" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" Style="{StaticResource SourceBox}" VirtualizingPanel.IsVirtualizing="True"/></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></ScrollViewer>
</UserControl>
