<Window x:Class="ATLink.Views.InternationalCalendarWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="International calendar" Width="1050" Height="740" MinWidth="740" MinHeight="520" WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Resources><Style TargetType="DatePickerTextBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource PanelBrush}"/></Style></Window.Resources>
 <Grid Margin="20" Background="{DynamicResource BackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="International calendar" FontSize="24" FontWeight="Bold"/><TextBlock Text="Men's matchdays · Move all slots of a matchday together. Hours, capacities and round numbers are preserved. Shared dates can affect other competitions. Player call-ups and career postponements cannot be predicted." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,12"/></StackPanel>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search a competition, friendly, qualifier or date" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding VisibleDays}"><ItemsControl.ItemTemplate><DataTemplate>
  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8"><StackPanel>
   <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Dates}" TextWrapping="Wrap" Margin="0,5"/><TextBlock Text="{Binding Details}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
   <WrapPanel Margin="0,8,0,0"><CheckBox Content="Move this matchday / merge its dates" IsChecked="{Binding Move}" VerticalAlignment="Center" Margin="0,0,15,0"/><DatePicker SelectedDate="{Binding Date}" IsEnabled="{Binding Move}" Width="170"/></WrapPanel>
  </StackPanel></Border>
 </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"/>
 </StackPanel></ScrollViewer>
 <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Undo" Click="Undo" IsEnabled="{Binding CanUndo}" Margin="0,0,8,0"/><Button Content="Redo" Click="Redo" IsEnabled="{Binding CanRedo}" Margin="0,0,8,0"/><Button Content="Preview changes" Click="Preview" Margin="0,0,8,0"/><Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/><Button Content="Apply" Click="Apply"/></WrapPanel>
 </Grid>
</Window>

