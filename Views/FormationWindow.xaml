<UserControl Foreground="{DynamicResource TextBrush}" x:Class="ATLink.Views.FormationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <DockPanel Background="{DynamicResource BackgroundBrush}"><Border DockPanel.Dock="Top" Padding="16" Background="{DynamicResource HeaderBrush}"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Back" Click="CancelClick" Margin="0,0,8,0"/><Button Background="{DynamicResource AccentBrush}" Content="Apply and Back" Click="ApplyClick"/></StackPanel><StackPanel><TextBlock Text="Team formation" FontSize="24" FontWeight="Bold"/><WrapPanel Margin="0,10,0,0"><TextBlock Text="Template" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="Templates" Width="180" SelectionChanged="TemplateChanged" Margin="0,0,16,0"/><TextBlock Text="Active mentality" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="Mentalities" Width="180" SelectionChanged="MentalityChanged"/></WrapPanel></StackPanel></DockPanel></Border><TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="16,8" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="470"/><ColumnDefinition/></Grid.ColumnDefinitions><Canvas x:Name="Pitch" Width="450" Height="600" Background="{DynamicResource PitchBrush}" VerticalAlignment="Top" ClipToBounds="True"/><TabControl Grid.Column="1"><TabItem Header="Lineup"><DataGrid x:Name="Lineup" AutoGenerateColumns="False" CanUserAddRows="False" CellEditEnding="Edited"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="35"/><DataGridComboBoxColumn x:Name="PlayerColumn" Header="Player" SelectedValueBinding="{Binding PlayerId}" DisplayMemberPath="Name" SelectedValuePath="Id" Width="190"/><DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="65"/><DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="65"/><DataGridTextColumn Header="X" Binding="{Binding X}" Width="60"/><DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="60"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Captain / set pieces"><StackPanel x:Name="Takers" Margin="12"/></TabItem></TabControl></Grid></DockPanel>
</UserControl>
