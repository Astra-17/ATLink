<UserControl x:Class="ATLink.Views.CompdataWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI" Background="#F7F8F5">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <DockPanel Background="#F7F8F5"><Border DockPanel.Dock="Top" Background="White" Padding="16"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Back" Click="BackClick" Margin="0,0,8,0"/><Button Content="Tournament tools" Click="ManageTournamentClick" Margin="0,0,8,0"/><Button Content="New tournament" Click="NewTournamentClick" Margin="0,0,8,0"/><Button Content="Create from competition" Click="CompetitionClick" Margin="0,0,8,0"/><Button Content="Validate" Click="ValidateClick" Margin="0,0,8,0"/><Button Content="Save As" Click="SaveClick"/></StackPanel><TextBlock Text="Compdata Editor" FontSize="22" FontWeight="Bold"/></DockPanel></Border><TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="16,8" TextWrapping="Wrap" Foreground="#607069"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions><ListBox x:Name="Files" DisplayMemberPath="RelativePath" SelectionChanged="SelectFile" Background="#EEF3EF" BorderThickness="0"/><TabControl Grid.Column="1" x:Name="EditorTabs" SelectionChanged="ChangeMode" Margin="12"><TabItem Header="Structured table"><DataGrid x:Name="Records" AutoGenerateColumns="True" CanUserAddRows="True" CanUserDeleteRows="True" EnableRowVirtualization="True" EnableColumnVirtualization="True"/></TabItem><TabItem Header="Raw text"><TextBox x:Name="Editor" FontFamily="Consolas" FontSize="14" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="EditText" Margin="12"/></TabItem></TabControl></Grid></DockPanel>
</UserControl>



