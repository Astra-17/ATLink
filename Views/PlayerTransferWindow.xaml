<Window xmlns:loc="clr-namespace:ATLink.Services" Style="{DynamicResource {x:Type Window}}" x:Class="ATLink.Views.PlayerTransferWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{loc:Text T9e2374b2105139}" Width="580" SizeToContent="{loc:Text Tbfe2eca4017973}" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/ATLink;component/Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="24" Background="{DynamicResource BackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <ToggleButton x:Name="TransferMode" Content="{loc:Text Tdde8bef78cbb72}" IsChecked="True" MinWidth="86" Padding="12,7" Click="TransferModeClick"/>
    <ToggleButton x:Name="LoanMode" Content="{loc:Text Tb138024ee7b40f}" MinWidth="72" Padding="12,7" Margin="6,0,0,0" Click="LoanModeClick"/>
   </StackPanel>
   <TextBlock x:Name="Heading" Text="{loc:Text T9e2374b2105139}" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,20,0">
    <Border Background="Black" CornerRadius="8" Width="120" Height="140"><Image x:Name="Portrait" Stretch="Uniform"/></Border>
    <TextBlock x:Name="PlayerName" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1">
    <StackPanel x:Name="CurrentClubPanel" Visibility="Collapsed" Margin="0,0,0,18"><TextBlock Text="{loc:Text T72e81feaa8a14f}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/><DockPanel><Image x:Name="CurrentClubCrest" Width="36" Height="36" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock x:Name="CurrentClubName" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></StackPanel><TextBlock x:Name="DestinationLabel" Text="{loc:Text T72e81feaa8a14f}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Image Source="{Binding SelectedItem.Crest, ElementName=Clubs}" Width="36" Height="36" Stretch="Uniform" Margin="0,0,8,0"/>
    <ComboBox x:Name="Clubs" Grid.Column="1" MinHeight="58" MaxDropDownHeight="300"
     IsEditable="True" IsTextSearchEnabled="False" TextSearch.TextPath="Name"
     StaysOpenOnEdit="True" HorizontalContentAlignment="Stretch"
     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
     ScrollViewer.CanContentScroll="True" ToolTip="{loc:Text T51a88b5a29bdc5}">
     <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
     <ComboBox.ItemTemplate><DataTemplate><DockPanel MinWidth="285">
      <Image Source="{Binding Crest}" Width="36" Height="36" Stretch="Uniform" Margin="0,0,10,0"/>
      <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,2,0" Foreground="{DynamicResource MutedBrush}" FontSize="11">
       <Run Text="("/><Run Text="{Binding Id}"/><Run Text=")"/>
      </TextBlock>
      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     </DockPanel></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    </Grid>
    <StackPanel x:Name="ContractPanel">
     <TextBlock Text="{loc:Text T90d629dace7a00}" Foreground="{DynamicResource MutedBrush}" Margin="0,20,0,7"/>
     <ComboBox x:Name="ContractYear" IsEditable="True" MinHeight="36"/>
    </StackPanel>
    <StackPanel x:Name="LoanPanel" Visibility="Collapsed">
     <TextBlock Text="{loc:Text T9b51ce072bb157}" Foreground="{DynamicResource MutedBrush}" Margin="0,20,0,7"/>
     <ComboBox x:Name="LoanEndDate" MinHeight="36"/>
     <CheckBox x:Name="LoanToBuy" Content="{loc:Text Ta3282b653622a1}" Margin="0,12,0,0"/>
    </StackPanel>
    <TextBlock Text="{loc:Text Tbd82cf16699be2}" Foreground="{DynamicResource MutedBrush}" Margin="0,20,0,7"/>
    <TextBox x:Name="JerseyNumber" MinHeight="36" Padding="8,6"/>
    <TextBlock x:Name="ErrorText" Foreground="#FFFF8E8E" TextWrapping="Wrap" Margin="0,12,0,0"/>
   </StackPanel>
  </Grid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
   <Button Content="{loc:Text T19766ed6ccb2f4}" IsCancel="True" MinWidth="95" Margin="0,0,10,0" Padding="14,9"/>
   <Button Content="{loc:Text Teebdd24a77d9ad}" IsDefault="True" MinWidth="95" Padding="14,9" Background="{DynamicResource AccentBrush}" Click="ConfirmClick"/>
  </StackPanel>
 </Grid>
</Window>
