<UserControl x:Class="ATLink.Views.FootballSeasonEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/><Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,20,0,10"/></Style></UserControl.Resources>
<StackPanel Margin="14"><TextBlock Text="Season behaviour" FontSize="26" FontWeight="Bold"/><TextBlock Text="{Binding ProfileNote}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10"/>
<CheckBox Content="Propose final-results updates automatically when creating this competition" IsChecked="{Binding AutomaticResults}"><CheckBox.Style><Style TargetType="CheckBox"><Style.Triggers><DataTrigger Binding="{Binding Existing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox>
<TextBlock Text="Teams and season rules" Style="{StaticResource Heading}"/><TextBlock Text="Rules run in the order below. Sources remain dynamic. Unknown game rules stay in Expert." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
<ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" MaxHeight="300"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="6"/></DataTemplate></ListBox.ItemTemplate></ListBox>
<WrapPanel Margin="0,10"><Button Content="+ Add rule" Click="AddRule" Margin="0,0,8,8"/><Button Content="Edit" Click="EditRule" Margin="0,0,8,8"/><Button Content="Remove" Click="RemoveRule" Margin="0,0,8,8"/><Button Content="↑" Click="UpRule" Margin="0,0,8,8"/><Button Content="↓" Click="DownRule" Margin="0,0,8,8"/><Button Content="Suggest missing season updates" IsEnabled="{Binding CanSuggest}" Click="Propose" Margin="0,0,8,8" Visibility="{Binding Existing,Converter={StaticResource Visible}}"/></WrapPanel>
<Expander Header="Initial previous-season standings (optional)" Margin="0,12"><StackPanel><TextBlock Text="This is the initial historical ranking, separate from participating clubs. Put the highest-ranked team first. Replacing it requires an explicit choice." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10"/><CheckBox Content="Replace initial standings with this ordered list" IsChecked="{Binding ReplaceInitial}"/><ComboBox ItemsSource="{Binding Clubs}" SelectedItem="{Binding InitialClub}" DisplayMemberPath="Name" Margin="0,10"/><WrapPanel><Button Content="Add club" Click="AddInitial" Margin="0,0,8,8"/><Button Content="Use selected creation clubs" Click="UseClubs" Margin="0,0,8,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Existing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></WrapPanel><ListBox ItemsSource="{Binding InitialTeams}" SelectedItem="{Binding SelectedInitial}" DisplayMemberPath="Name" MaxHeight="200"/><WrapPanel Margin="0,8"><Button Content="Remove" Click="RemoveInitial" Margin="0,0,8,0"/><Button Content="↑" Click="UpInitial" Margin="0,0,8,0"/><Button Content="↓" Click="DownInitial"/></WrapPanel></StackPanel></Expander>
<Expander Header="Season and linked competitions" Margin="0,12"><StackPanel><TextBlock Text="Season starts in" Margin="0,10,0,5"/><ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding StartMonth}" DisplayMemberPath="Name"/><TextBlock Text="Promotion destination" Margin="0,10,0,5"/><ComboBox ItemsSource="{Binding LinkCompetitions}" SelectedItem="{Binding Promotion}" DisplayMemberPath="Name"/><TextBlock Text="Relegation destination" Margin="0,10,0,5"/><ComboBox ItemsSource="{Binding LinkCompetitions}" SelectedItem="{Binding Relegation}" DisplayMemberPath="Name"/><TextBlock Text="Playoff competition" Margin="0,10,0,5"/><ComboBox ItemsSource="{Binding Competitions}" SelectedItem="{Binding Playoff}" DisplayMemberPath="Name"/><TextBlock Text="These links describe the competition relationships. Qualification places are configured separately; existing club league memberships stay unchanged." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10"/></StackPanel></Expander>
<Expander Header="Qualification destinations" Margin="0,12" Visibility="{Binding Existing,Converter={StaticResource Visible}}"><StackPanel><TextBlock Text="Final results group" Margin="0,10,0,5"/><ComboBox ItemsSource="{Binding ResultsGroups}" SelectedItem="{Binding ResultsGroup}" DisplayMemberPath="Name"/><TextBlock Text="Qualification type" Margin="0,10,0,5"/><ComboBox ItemsSource="{Binding QualificationKinds}" SelectedItem="{Binding QualificationKind}" DisplayMemberPath="Label"/><TextBlock Text="Top teams qualifying" Margin="0,10,0,5"/><ComboBox ItemsSource="{Binding PlaceCounts}" SelectedItem="{Binding QualifierCount}"/><TextBlock Text="Destination competition" Margin="0,10,0,5"/><ComboBox ItemsSource="{Binding Competitions}" SelectedItem="{Binding QualificationDestination}" DisplayMemberPath="Name"/><TextBlock Text="Destination pool" Margin="0,10,0,5"/><ComboBox ItemsSource="{Binding DestinationPools}" SelectedItem="{Binding DestinationPool}" DisplayMemberPath="Name"/><WrapPanel Margin="0,10"><Button Content="Preview qualification" Click="ReviewQualification" Margin="0,0,8,0"/><Button Content="Connect qualifiers" Click="ConnectQualification"/></WrapPanel><TextBlock Text="{Binding QualificationPreview}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Expander><Expander x:Name="CalendarSection" Header="Calendar generation" Margin="0,12"><StackPanel><TextBlock Text="{Binding ReferenceLabel}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10"/><ComboBox ItemsSource="{Binding CalendarModes}" SelectedItem="{Binding CalendarMode}"/><WrapPanel Margin="0,10"><StackPanel Width="180" Margin="0,0,14,0"><TextBlock Text="First match date" Margin="0,0,0,5"/><DatePicker SelectedDate="{Binding FirstDate}"/></StackPanel><StackPanel Width="120" Margin="0,0,14,0"><TextBlock Text="Days between rounds" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding Interval}"/></StackPanel><StackPanel Width="120"><TextBlock Text="Kick-off (HH:mm)" Margin="0,0,0,5"/><TextBox Text="{Binding Kickoff,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></WrapPanel><TextBlock Text="Assigned first-stage fixtures require all clubs to be selected explicitly and a league/group first phase. Existing assigned fixtures and shared calendars are kept in the Calendar editor." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><Button Content="Regenerate relative calendar" Click="Regenerate" HorizontalAlignment="Left" Margin="0,10" Visibility="{Binding Existing,Converter={StaticResource Visible}}"/></StackPanel></Expander>
<Expander Header="Add an assigned match" Margin="0,12" Visibility="{Binding Existing,Converter={StaticResource Visible}}"><StackPanel><TextBlock Text="Played phase" Margin="0,10,0,5"/><ComboBox ItemsSource="{Binding PlayedPhases}" SelectedItem="{Binding FixturePhase}" DisplayMemberPath="Name"/><WrapPanel Margin="0,10"><DatePicker SelectedDate="{Binding FixtureDate}" Width="180" Margin="0,0,14,0"/><TextBox Text="{Binding FixtureKickoff,UpdateSourceTrigger=PropertyChanged}" Width="120" ToolTip="Kick-off HH:mm"/></WrapPanel><TextBlock Text="Home club" Margin="0,10,0,5"/><ComboBox ItemsSource="{Binding Clubs}" SelectedItem="{Binding HomeClub}" DisplayMemberPath="Name"/><TextBlock Text="Away club" Margin="0,10,0,5"/><ComboBox ItemsSource="{Binding Clubs}" SelectedItem="{Binding AwayClub}" DisplayMemberPath="Name"/><Button Content="Add assigned match" Click="AddAssignedMatch" HorizontalAlignment="Left" Margin="0,12"/><TextBlock Text="{Binding FixtureMessage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Expander><Button Content="Review season behaviour" Click="Review" HorizontalAlignment="Left" Margin="0,18,0,10"/><TextBlock Text="{Binding Preview}" TextWrapping="Wrap"/><CheckBox Content="I have reviewed these season rules and changes" IsChecked="{Binding ConfirmChanges}" Margin="0,14" Visibility="{Binding Existing,Converter={StaticResource Visible}}"/><Button Content="Apply season behaviour" Click="Apply" HorizontalAlignment="Left" Visibility="{Binding Existing,Converter={StaticResource Visible}}"/><TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" Margin="0,12"/>
</StackPanel></UserControl>