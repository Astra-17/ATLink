<UserControl x:Class="ATLink.Views.CreationCalendarEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ATLink.Views">
<UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/><Style TargetType="DatePicker"><Setter Property="Language" Value="en-GB"/><Setter Property="SelectedDateFormat" Value="Short"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="MinHeight" Value="36"/></Style><Style TargetType="DatePickerTextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/></Style></UserControl.Resources>
<StackPanel Margin="10"><DockPanel><ComboBox DockPanel.Dock="Right" Width="240" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" SelectionChanged="ModeChanged"/><TextBlock Text="Dates &amp; matches" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel><local:CalendarBoard DataContext="{Binding Board}"/>
<StackPanel Visibility="{Binding DataContext.Automatic,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource Visible}}" DataContext="{Binding Season}" Margin="0,18"><ComboBox ItemsSource="{Binding CalendarModes}" SelectedItem="{Binding CalendarMode}"/><WrapPanel Margin="0,12"><StackPanel Width="180" Margin="0,0,12,0"><TextBlock Text="First match date"/><DatePicker SelectedDate="{Binding FirstDate}"/></StackPanel><StackPanel Width="120" Margin="0,0,12,0"><TextBlock Text="Days between rounds"/><ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding Interval}"/></StackPanel><StackPanel Width="110"><TextBlock Text="Kick-off HH:mm"/><TextBox Text="{Binding Kickoff,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></WrapPanel></StackPanel>
<Expander Header="Detailed matchdays and bulk actions" IsExpanded="False" Visibility="{Binding Manual,Converter={StaticResource Visible}}"><StackPanel Margin="0,18"><WrapPanel><Button Content="Build / update matchdays" Click="Build" Margin="0,0,10,10"/><Button Content="Reset all dates" Click="Reset" Margin="0,0,0,10"/></WrapPanel><TextBlock Text="Set each date and time below. Capacity is the number of matches that may use a slot; these are not confirmed team fixtures. Use + Time slot to spread a matchday over several dates or kick-off times." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
<Expander Header="Adjust a whole phase" Margin="0,0,0,16"><StackPanel Margin="8,12"><TextBlock Text="Choose a phase. Moving its first date keeps the spacing between its matchdays; changing the time also updates its assigned fixtures. Conflicting changes are rejected without altering the draft." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/><ComboBox ItemsSource="{Binding Phases}" SelectedItem="{Binding BulkPhase}" DisplayMemberPath="Name"/><WrapPanel Margin="0,12"><DatePicker SelectedDate="{Binding BulkDate}" Width="170" Margin="0,0,12,8"/><Button Content="Move phase start" Click="MovePhaseDates" Margin="0,0,12,8"/><TextBox Text="{Binding BulkTime,UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,12,8"/><Button Content="Apply kick-off" Click="ApplyPhaseTime" Margin="0,0,0,8"/></WrapPanel></StackPanel></Expander><ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"><StackPanel><TextBlock Text="{Binding Phase.Name}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding Phase.Matches,StringFormat='{}{0} matches per matchday'}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,12"/>
<ListBox ItemsSource="{Binding Rows}" MaxHeight="390" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="8"><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,8"/><WrapPanel><StackPanel Width="160" Margin="0,0,12,8"><TextBlock Text="Date"/><DatePicker SelectedDate="{Binding Date}"/></StackPanel><StackPanel Width="90" Margin="0,0,12,8"><TextBlock Text="Kick-off"/><TextBox Text="{Binding Kickoff,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Width="90" Margin="0,0,12,8"><TextBlock Text="Capacity"/><ComboBox ItemsSource="{Binding Counts}" SelectedItem="{Binding Maximum}"/></StackPanel></WrapPanel><WrapPanel><Button Content="+ Time slot" Click="Split" Margin="0,0,8,0"/><Button Content="Remove" Click="RemoveSlot"/></WrapPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander>
<StackPanel Visibility="{Binding CanAssign,Converter={StaticResource Visible}}" Margin="0,18"><TextBlock Text="Known fixtures" FontSize="22" FontWeight="Bold"/><TextBlock Text="In Exact fixtures mode, only the matches entered here are scheduled. With matchday dates, you can also assign known clubs to a matching time slot and leave later-round teams undecided." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,14"/><TextBlock Text="Phase"/><ComboBox ItemsSource="{Binding Phases}" SelectedItem="{Binding FixturePhase}" DisplayMemberPath="Name"/><WrapPanel Margin="0,12"><DatePicker SelectedDate="{Binding FixtureDate}" Width="180" Margin="0,0,12,0"/><TextBox Text="{Binding FixtureTime,UpdateSourceTrigger=PropertyChanged}" Width="110" ToolTip="Kick-off HH:mm"/></WrapPanel><TextBlock Text="Home club"/><ComboBox ItemsSource="{Binding Clubs}" SelectedItem="{Binding Home}" DisplayMemberPath="Name"/><TextBlock Text="Away club" Margin="0,12,0,0"/><ComboBox ItemsSource="{Binding Clubs}" SelectedItem="{Binding Away}" DisplayMemberPath="Name"/><Button Content="+ Add fixture" Click="AddFixture" HorizontalAlignment="Left" Margin="0,12"/><ListBox ItemsSource="{Binding Fixtures}" SelectedItem="{Binding SelectedFixture}" MaxHeight="260"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding PhaseName}" FontWeight="Bold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="Remove selected fixture" Click="RemoveFixture" HorizontalAlignment="Left" Margin="0,8"/></StackPanel>
<TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,14"/><TextBlock Text="{Binding Note}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="{Binding Season.ReferenceLabel}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12"/></StackPanel></UserControl>