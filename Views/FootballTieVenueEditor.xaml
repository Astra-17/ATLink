<UserControl x:Class="ATLink.Views.FootballTieVenueEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
 <StackPanel Margin="0,8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding InheritedVenue}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,5"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
 <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" DisplayMemberPath="Label" IsEnabled="{Binding CanEdit}"/>
 <StackPanel Visibility="{Binding Custom,Converter={StaticResource Visible}}" IsEnabled="{Binding CanEdit}"><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search stadiums by name or ID" Margin="0,8,0,4"/><ComboBox ItemsSource="{Binding StadiumChoices}" SelectedItem="{Binding SelectedStadium}" DisplayMemberPath="Name" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/></StackPanel>
 <TextBlock Text="{Binding Note}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6"/><TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/></StackPanel>
</UserControl>
