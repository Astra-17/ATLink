<UserControl x:Class="ATLink.Views.EntityEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F7F8F5" FontFamily="Segoe UI" FontSize="13">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <DockPanel Background="#F7F8F5"><Border DockPanel.Dock="Top" Background="White" BorderBrush="#CFD8D2" BorderThickness="0,0,0,1" Padding="18"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Cancel" Click="CancelClick" Margin="0,0,8,0"/><Button Content="Apply and Back" Click="ApplyClick" Background="#1F7A5A" Foreground="White"/></StackPanel><StackPanel><TextBlock x:Name="Kicker" Foreground="#607069"/><TextBlock x:Name="EntityTitle" FontSize="24" FontWeight="Bold"/></StackPanel></DockPanel></Border><TextBlock DockPanel.Dock="Bottom" x:Name="ErrorText" Foreground="#B33A3A" TextWrapping="Wrap" Margin="18,8"/><TabControl x:Name="Tabs" Margin="18" Background="White" BorderBrush="#CFD8D2"/></DockPanel>
</UserControl>

