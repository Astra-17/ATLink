<UserControl xmlns:loc="clr-namespace:ATLink.Services" x:Class="ATLink.Views.PlayerEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ATLink.Views" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource BackgroundBrush}" FontSize="13">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
     <Border x:Name="Tab" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="28,12" Margin="0,0,4,0"><ContentPresenter ContentSource="Header"/></Border>
     <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <!-- Dimensions of player rating inputs only; keep the shared TextBox template flexible. -->
   <Style x:Key="PlayerRatingInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Width" Value="30"/><Setter Property="Height" Value="20"/>
    <Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
      <ScrollViewer x:Name="PART_ContentHost"/>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><DataTrigger Binding="{Binding IsValid}" Value="False"><Setter Property="BorderBrush" Value="#FF929F"/></DataTrigger></Style.Triggers>
   </Style>
   <DataTemplate x:Key="NumberEditor">
    <Grid Width="54" Height="24">
     <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
     <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Background="{Binding Brush}" Foreground="White" Style="{StaticResource PlayerRatingInput}" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" KeyDown="NumberKeyDown" ToolTip="{loc:Text T32eec6698c2360}">

     </TextBox>
     <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <Button Content="⌃" Tag="1" Click="StepClick" MinHeight="0" Padding="0" FontSize="10"/>
      <Button Grid.Row="1" Content="⌄" Tag="-1" Click="StepClick" MinHeight="0" Padding="0" FontSize="10"/>
     </Grid>
    </Grid>
   </DataTemplate>
   <DataTemplate x:Key="GroupCard">
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Margin="0,0,0,14">
     <StackPanel>
      <Border BorderBrush="{Binding Brush}" BorderThickness="4,0,0,0" Padding="9,7" CornerRadius="6,6,0,0">
       <!-- Solid left edge and rating badge; tinted background fades into the panel. -->
       <Border.Background>
        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
         <GradientStop Color="{Binding HeaderTint}" Offset="0"/>
         <GradientStop Color="{Binding HeaderTint}" Offset="0.12"/>
         <GradientStop Color="Transparent" Offset="1"/>
        </LinearGradientBrush>
       </Border.Background>
       <DockPanel><Border DockPanel.Dock="Right" Background="{Binding Brush}" CornerRadius="4" Width="30" Height="20"><TextBlock Text="{Binding Rating}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" ToolTip="{loc:Text Tdfa5f005cefe3f}"/></DockPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding Attributes}" AlternationCount="2">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border Padding="10,3">
         <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Style.Triggers><DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="1"><Setter Property="Background" Value="{DynamicResource AlternateRowBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
         <DockPanel><ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource NumberEditor}"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/></DockPanel>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Border>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>
 <DockPanel>
  <StackPanel DockPanel.Dock="Top">
   <Button Content="{loc:Text T55028835a30f5f}" Click="BackClick" HorizontalAlignment="Left" Margin="0,0,0,8"/>
   <Border CornerRadius="16" BorderBrush="#7438AA" BorderThickness="1" Padding="18,10" Margin="0,0,0,10">
    <Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#171025"/><GradientStop Color="#24103F" Offset=".55"/><GradientStop Color="#42145F" Offset="1"/></LinearGradientBrush></Border.Background>
    <Grid MinHeight="116">
     <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
     <Border Width="112" Height="112" CornerRadius="38" BorderBrush="#B337FF" BorderThickness="2" Background="#211035">
      <Border.Effect><DropShadowEffect Color="#A02AFF" BlurRadius="18" ShadowDepth="0" Opacity=".7"/></Border.Effect>
      <Image x:Name="Portrait" Width="108" Height="108" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,108,108" RadiusX="36" RadiusY="36"/></Image.Clip></Image>
     </Border>
     <Grid Grid.Column="1" Margin="12,0,18,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal"><TextBlock x:Name="PlayerName" FontSize="28" FontWeight="Bold"/><Button Content="✎" ToolTip="{loc:Text T983facff538bc2}" Click="EditNameClick" Margin="10,0,0,0" Padding="0" Width="35" Height="35" MinWidth="35" MinHeight="35" VerticalAlignment="Center"/></StackPanel>
      <TextBox x:Name="NameDraft" Visibility="Collapsed" FontSize="22" TextChanged="NameDraftChanged"/>
      <TextBlock x:Name="PlayerId" Grid.Row="1" Foreground="#C3B5E3" Margin="0,3,0,8"/>
      <Grid Grid.Row="2" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <UniformGrid Columns="4" Width="600" HorizontalAlignment="Center"><Border BorderBrush="#507E639A" BorderThickness="0,0,1,0" Padding="6,0"><StackPanel HorizontalAlignment="Center"><TextBlock TextAlignment="Center" Text="{loc:Text T6d7c4dd8859002}" Foreground="#C3B5E3" FontSize="14"/><TextBlock TextAlignment="Center" x:Name="HeaderAge" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border BorderBrush="#507E639A" BorderThickness="0,0,1,0" Padding="6,0"><StackPanel HorizontalAlignment="Center"><TextBlock TextAlignment="Center" Text="{loc:Text T94effc0153ff5b}" Foreground="#C3B5E3" FontSize="14"/><TextBlock TextAlignment="Center" x:Name="HeaderPosition" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border BorderBrush="#507E639A" BorderThickness="0,0,1,0" Padding="6,0"><StackPanel HorizontalAlignment="Center"><TextBlock TextAlignment="Center" Text="{loc:Text T77093e0c33ff0d}" Foreground="#C3B5E3" FontSize="14"/><TextBlock TextAlignment="Center" x:Name="HeaderHeight" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border BorderBrush="#507E639A" BorderThickness="0,0,1,0" Padding="6,0"><StackPanel HorizontalAlignment="Center"><TextBlock TextAlignment="Center" Text="{loc:Text T4da16ecfc805a4}" Foreground="#C3B5E3" FontSize="14"/><TextBlock TextAlignment="Center" x:Name="HeaderFoot" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border></UniformGrid>
       <Border Grid.Column="1" CornerRadius="8" BorderBrush="#503464" BorderThickness="1" Background="#221433" Padding="8,6" Margin="12,0,6,0" VerticalAlignment="Center"><DockPanel><Image x:Name="Crest" Width="36" Height="30" Margin="0,0,8,0"/><TextBlock x:Name="ClubName" FontSize="16" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
       <Border Grid.Column="2" CornerRadius="8" BorderBrush="#503464" BorderThickness="1" Background="#221433" Padding="8,6" Margin="6,0,0,0" VerticalAlignment="Center"><DockPanel><local:FlagImage x:Name="Flag" Width="36" Height="26" Margin="0,0,8,0"/><TextBlock x:Name="Nation" FontSize="16" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
      </Grid>
     </Grid>
     <Border Grid.Column="2" CornerRadius="14" BorderBrush="{Binding OverallBorderBrush}" BorderThickness="2" Height="90" VerticalAlignment="Center" Background="{Binding OverallReliefBrush}">
      <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Text Tb8f1eee94c415e}" HorizontalAlignment="Center"/><TextBlock Text="{Binding Overall}" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
     </Border>
    </Grid>
   </Border>
  </StackPanel>
  <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
   <Button DockPanel.Dock="Right" Content="{loc:Text T85045ccc056780}" Background="{DynamicResource AccentBrush}" Click="ApplyClick" Padding="16,8"/>
   <TextBlock x:Name="Error" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel>
  <TabControl x:Name="EditorTabs" SelectedIndex="0">
   <TabItem Header="{loc:Text T170322a32f3c35}"><ContentControl x:Name="InfoHost"/></TabItem>
   <TabItem Header="{loc:Text T4b0ed88f7d9942}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource PlayerDetailsBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,16,0">
       <StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="{loc:Text T79d48bb188ee59}" Click="ResetClick"/><TextBlock Text="{loc:Text T4b0ed88f7d9942}" FontSize="20" FontWeight="SemiBold"/></DockPanel>
        <TextBlock Text="{loc:Text Tfe49d9e55b45f3}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,18" TextWrapping="Wrap"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <ItemsControl ItemsSource="{Binding LeftGroups}" ItemTemplate="{StaticResource GroupCard}" Margin="0,0,10,0"/>
         <ItemsControl Grid.Column="1" ItemsSource="{Binding RightGroups}" ItemTemplate="{StaticResource GroupCard}" Margin="10,0,0,0"/>
        </Grid>
       </StackPanel>
      </Border>
      <StackPanel Grid.Column="1">
       <Border Background="{DynamicResource PlayerDetailsBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel><TextBlock Text="{loc:Text Tee1d0105939b79}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
         <UniformGrid Columns="2">
          <StackPanel><TextBlock Text="{loc:Text Tee62b830579d67}" Margin="0,0,0,6"/><Border Background="{Binding OverallBrush}" Width="64" Height="40" CornerRadius="6" HorizontalAlignment="Left"><TextBlock Text="{Binding Overall}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
          <StackPanel><TextBlock Text="{loc:Text Ta676b9f77ebc56}" Margin="0,0,0,6"/><ContentControl Content="{Binding Potential}" ContentTemplate="{StaticResource NumberEditor}" HorizontalAlignment="Left"/></StackPanel>
         </UniformGrid>
         <local:AttributeRadar x:Name="Radar" Height="280"/>
         <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>
       <Border Background="{DynamicResource PlayerDetailsBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
        <StackPanel><TextBlock Text="{loc:Text T863162b78165c3}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
         <!-- Fixed pitch coordinates are scaled uniformly, preserving circular badges. -->
         <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
          <Grid Width="300" Height="444">
           <Border Background="{DynamicResource PitchBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12"/>
           <Canvas IsHitTestVisible="False" Opacity="0.45">
            <Rectangle Canvas.Left="15" Canvas.Top="12" Width="270" Height="420" RadiusX="5" RadiusY="5" Stroke="{DynamicResource PitchLineBrush}" StrokeThickness="1"/>
            <Line X1="15" Y1="222" X2="285" Y2="222" Stroke="{DynamicResource PitchLineBrush}" StrokeThickness="1"/>
            <Ellipse Canvas.Left="112" Canvas.Top="184" Width="76" Height="76" Stroke="{DynamicResource PitchLineBrush}" StrokeThickness="1"/>
            <Ellipse Canvas.Left="148" Canvas.Top="220" Width="4" Height="4" Fill="{DynamicResource PitchLineBrush}"/>
            <Rectangle Canvas.Left="83" Canvas.Top="12" Width="134" Height="65" Stroke="{DynamicResource PitchLineBrush}" StrokeThickness="1"/>
            <Rectangle Canvas.Left="115" Canvas.Top="12" Width="70" Height="24" Stroke="{DynamicResource PitchLineBrush}" StrokeThickness="1"/>
            <Rectangle Canvas.Left="83" Canvas.Top="367" Width="134" Height="65" Stroke="{DynamicResource PitchLineBrush}" StrokeThickness="1"/>
            <Rectangle Canvas.Left="115" Canvas.Top="408" Width="70" Height="24" Stroke="{DynamicResource PitchLineBrush}" StrokeThickness="1"/>
           </Canvas>
           <ItemsControl ItemsSource="{Binding PitchRatings}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter">
             <Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/>
            </Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate><DataTemplate>
             <Grid Width="44" Height="44" ToolTip="{Binding Name, StringFormat=Rating at {0}}">
              <Ellipse Fill="{Binding Brush}" Stroke="#55FFFFFF" StrokeThickness="1"/>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
               <TextBlock Text="{Binding Name}" Foreground="White" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
               <TextBlock Text="{Binding Rating}" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
              </StackPanel>
             </Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
           </ItemsControl>
          </Grid>
         </Viewbox>
        </StackPanel>
       </Border>
      </StackPanel>
     </Grid>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="{loc:Text T191849ddd0b33a}" IsEnabled="False"/>
   <TabItem Header="{loc:Text T3907fa7f80722a}"><ContentControl x:Name="AppearanceHost"/></TabItem>
  </TabControl>
 </DockPanel>
</UserControl>
