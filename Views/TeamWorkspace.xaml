<UserControl x:Class="ATLink.Views.TeamWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F7F8F5" FontFamily="Segoe UI" FontSize="13">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="TeamTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="MinHeight" Value="32"/></Style>
   <Style x:Key="ApplyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#1F7A5A"/><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
   <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="#1F7A5A"/><Setter Property="BorderBrush" Value="#1F7A5A"/></Style>
   <Style x:Key="RemoveButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="#B33A3A"/><Setter Property="BorderBrush" Value="#E8B4B4"/><Setter Property="Padding" Value="12,6"/></Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <DockPanel Background="#F7F8F5">
  <Border DockPanel.Dock="Top" Background="White" BorderBrush="#CFD8D2" BorderThickness="0,0,0,1" Padding="16,12">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="Apply" Click="ApplyClick" Style="{StaticResource ApplyButton}"/>
     <Button Content="Apply and Back" Click="ApplyBackClick" Margin="0,0,8,0"/>
     <Button Content="Apply and Save" Click="ApplySaveClick"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal">
     <Button Content="Back" Click="CancelClick" VerticalAlignment="Center" Margin="0,0,14,0"/>
     <Border Width="64" Height="64" CornerRadius="8" Background="#EEF3EF" BorderBrush="#CFD8D2" BorderThickness="1" Margin="0,0,12,0">
      <Image x:Name="Crest" Stretch="Uniform" Margin="4"/>
     </Border>
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="TeamKicker" Foreground="#607069" FontSize="12"/>
      <TextBlock x:Name="TeamTitle" FontSize="24" FontWeight="Bold"/>
      <StackPanel x:Name="Badges" Orientation="Horizontal" Margin="0,6,0,0"/>
     </StackPanel>
    </StackPanel>
   </DockPanel>
  </Border>
  <TextBlock DockPanel.Dock="Bottom" x:Name="ErrorText" Foreground="#B33A3A" TextWrapping="Wrap" Margin="16,8"/>
  <DockPanel>
   <WrapPanel x:Name="TabBar" DockPanel.Dock="Top" Margin="16,12,16,0"/>
   <ScrollViewer x:Name="Host" Margin="16,4,16,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
  </DockPanel>
 </DockPanel>
</UserControl>
