<UserControl Foreground="{DynamicResource TextBrush}" x:Class="ATLink.Views.TransfermarktWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <DockPanel Background="{DynamicResource BackgroundBrush}"><Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="16"><StackPanel><DockPanel><Button Content="Back" Click="BackClick" DockPanel.Dock="Right"/><TextBlock Text="Transfermarkt" FontSize="24" FontWeight="Bold"/></DockPanel><TextBlock Text="Fetch / import → resolve → review → apply" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,12"/><WrapPanel x:Name="Actions"><TextBox x:Name="Url" Width="510" Text="https://www.transfermarkt.fr/ligue-1/transfers/wettbewerb/FR1" Margin="0,0,8,0"/><Button Content="Fetch" Click="FetchClick" Margin="0,0,8,0"/><Button Content="Open HTML / CSV" Click="OpenClick" Margin="0,0,8,0"/><Button Content="Export results" Click="ExportClick" Margin="0,0,8,0"/><Button Content="Preview apply" Click="ApplyClick"/></WrapPanel></StackPanel></Border><TextBlock DockPanel.Dock="Bottom" x:Name="Status" Margin="16,10" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Text="Unresolved IDs must be filled in or their rows deliberately removed before applying."/><DataGrid x:Name="Results" Margin="16" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Sequence" Binding="{Binding Sequence}" IsReadOnly="True"/><DataGridTextColumn Header="Player" Binding="{Binding Player}" IsReadOnly="True" Width="180"/><DataGridTextColumn Header="Old club" Binding="{Binding OldClub}" IsReadOnly="True" Width="150"/><DataGridTextColumn Header="New club" Binding="{Binding NewClub}" IsReadOnly="True" Width="150"/><DataGridTextColumn Header="FC26 player ID" Binding="{Binding PlayerId,UpdateSourceTrigger=LostFocus}" Width="120"/><DataGridTextColumn Header="FC26 team ID" Binding="{Binding TeamId,UpdateSourceTrigger=LostFocus}" Width="120"/><DataGridTextColumn Header="Resolution" Binding="{Binding Match}" IsReadOnly="True" Width="*"/></DataGrid.Columns></DataGrid></DockPanel>
</UserControl>
