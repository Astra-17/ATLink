<UserControl x:Class="ATLink.Views.CalendarBoard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
 <StackPanel Margin="0,10"><Button Content="International calendar" Click="InternationalCalendar" HorizontalAlignment="Left" Margin="0,0,0,10"/><WrapPanel Margin="0,0,0,8"><StackPanel Width="180" Margin="0,0,8,4"><TextBlock Text="Follow a team"/><ComboBox ItemsSource="{Binding TeamChoices}" SelectedItem="{Binding Team}" DisplayMemberPath="Name"/></StackPanel><StackPanel Width="180" Margin="0,0,8,4"><TextBlock Text="Phase"/><ComboBox ItemsSource="{Binding PhaseChoices}" SelectedItem="{Binding Phase}" DisplayMemberPath="Name"/></StackPanel><StackPanel Width="80" Margin="0,0,8,4"><TextBlock Text="Rest days"/><ComboBox ItemsSource="{Binding RestChoices}" SelectedItem="{Binding RestDays}"/></StackPanel><Button Content="Availability" Click="LoadAvailability" ToolTip="Load / refresh other competitions" Margin="0,16,6,4" IsEnabled="{Binding CanWork}"/><Button Content="Cancel" Click="CancelWork" Margin="0,16,6,4" Visibility="{Binding Busy,Converter={StaticResource Visible}}"/><Button Content="Undo" Click="Undo" IsEnabled="{Binding CanUndo}" Margin="0,16,6,4"/><Button Content="Redo" Click="Redo" IsEnabled="{Binding CanRedo}" Margin="0,16,0,4"/></WrapPanel>
<ProgressBar Value="{Binding Progress,Mode=OneWay}" Maximum="100" Height="5" Visibility="{Binding Busy,Converter={StaticResource Visible}}"/>
<TextBlock Text="Known fixture ●   Simulated fixture ◇   Possible matchday ○   INT = men's international calendar (shared dates when linked)" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,0,6"/><DockPanel Margin="0,4,0,12"><Button DockPanel.Dock="Left" Content="‹" Click="Previous"/><Button DockPanel.Dock="Right" Content="›" Click="Next"/><Button DockPanel.Dock="Right" Content="First month" Click="FirstMonth" Margin="8,0"/><TextBlock Text="{Binding MonthTitle}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/></DockPanel>
 <StackPanel Visibility="{Binding HasProposal,Converter={StaticResource Visible}}" Margin="0,6"><TextBlock Text="Simulation preview — not applied" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/><WrapPanel><Button Content="Apply proposed dates" Click="ApplyProposal" Margin="0,4,8,4"/><Button Content="Discard preview" Click="DiscardProposal" Margin="0,4"/></WrapPanel></StackPanel><UniformGrid Columns="7"><TextBlock Text="Mon"/><TextBlock Text="Tue"/><TextBlock Text="Wed"/><TextBlock Text="Thu"/><TextBlock Text="Fri"/><TextBlock Text="Sat"/><TextBlock Text="Sun"/></UniformGrid>
 <ItemsControl x:Name="MonthDays" ItemsSource="{Binding Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border BorderThickness="2" CornerRadius="4" Margin="2"><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding HasCompetitionMatches}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><Button Click="OpenDay" MinHeight="58" Padding="5" Margin="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Opacity="{Binding Opacity}" ToolTip="{Binding Tooltip}"><StackPanel><DockPanel><TextBlock Text="{Binding More}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding Day}" FontWeight="Bold"/></DockPanel><Border Background="#40321B" BorderBrush="#EABA36" BorderThickness="1" CornerRadius="4" Padding="3,1" Margin="0,3" Visibility="{Binding HasInternationalMarker,Converter={StaticResource Visible}}" ToolTip="{Binding InternationalDetails}"><TextBlock Text="{Binding InternationalMarker}" Foreground="#EABA36" FontSize="10" FontWeight="SemiBold"/></Border><ItemsControl ItemsSource="{Binding Teams}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding Crest}" Width="20" Height="20" Stretch="Uniform" ToolTip="{Binding Name}" Margin="1"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Caption}" FontSize="10" TextWrapping="Wrap" MaxHeight="28"/><TextBlock Text="{Binding Problems}" FontSize="10" Foreground="{DynamicResource ErrorBrush}" TextTrimming="CharacterEllipsis" MaxHeight="14"/></StackPanel></Button></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding ParticipantCoverage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8"/><TextBlock Text="{Binding Coverage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8"/><Expander Header="Availability coverage and limitations"><ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding CoverageDetails}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></ScrollViewer></Expander><TextBlock Text="{Binding Reference}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8"/><Expander Header="Simulate schedule" IsExpanded="False" Margin="0,14"><StackPanel Margin="8"><TextBlock Text="Proposals never move other competitions. Select allowed days, then inspect and apply the result." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><WrapPanel Margin="0,10"><StackPanel Width="170" Margin="0,0,12,8"><TextBlock Text="First date"/><DatePicker SelectedDate="{Binding Start}"/></StackPanel><StackPanel Width="170" Margin="0,0,12,8"><TextBlock Text="Last date"/><DatePicker SelectedDate="{Binding End}"/></StackPanel><StackPanel Width="110"><TextBlock Text="Preferred time"/><ComboBox ItemsSource="{Binding TimeChoices}" SelectedItem="{Binding PreferredTime}"/></StackPanel></WrapPanel><ItemsControl ItemsSource="{Binding Weekdays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Allowed}" Margin="0,0,12,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Simulate schedule" Click="Simulate" IsEnabled="{Binding CanWork}" HorizontalAlignment="Left" Margin="0,10"/><StackPanel Visibility="{Binding HasProposal,Converter={StaticResource Visible}}"><TextBlock Text="{Binding ProposalText}" TextWrapping="Wrap" Margin="0,10"/><Expander Header="Proposed dates"><TextBox Text="{Binding ProposalDates,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="180" VerticalScrollBarVisibility="Auto"/></Expander><Button Content="Apply proposed dates" Click="ApplyProposal" HorizontalAlignment="Left" Margin="0,10"/></StackPanel></StackPanel></Expander>
 <Button Content="Use these fixtures…" Click="UseFixtures" IsEnabled="{Binding CanWork}" HorizontalAlignment="Left" Margin="0,10"/><TextBlock Text="Only confirmed, fully named fixtures are exported as assigned matches. Other cards remain available capacity. Selecting a team only filters the display; all participants are checked." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,12"/>
 </StackPanel>
</UserControl>
