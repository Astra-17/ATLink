 <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Text T8458dbc90243aa}" Margin="0,0,0,12" Visibility="{Binding AllRules,Converter={StaticResource Visible}}"/>
