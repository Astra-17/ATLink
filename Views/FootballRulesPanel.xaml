<UserControl x:Class="ATLink.Views.FootballRulesPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/><Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,12,0,8"/></Style></UserControl.Resources>
 <StackPanel>
 <CheckBox Content="All rules for this phase" IsChecked="{Binding AllRules}" Margin="0,8"/>
 <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search compatible rules" Margin="0,0,0,12" Visibility="{Binding AllRules,Converter={StaticResource Visible}}"/>
 <ItemsControl ItemsSource="{Binding Sections}"><ItemsControl.ItemTemplate><DataTemplate><Expander Header="{Binding Name}" IsExpanded="True" Margin="0,6"><ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate>
 <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12" Margin="0,2"><Grid IsEnabled="{Binding Supported}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding Help}"/><CheckBox Content="Competition default" IsChecked="{Binding UseDefault}" Margin="0,7,0,0"/></StackPanel><Grid Grid.Column="1" IsEnabled="{Binding Customized}"><TextBox Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding Toggle}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><CheckBox Content="Enabled" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Visibility="{Binding Toggle,Converter={StaticResource Visible}}"/></Grid></Grid></Border>
 </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <StackPanel Visibility="{Binding Tables,Converter={StaticResource Visible}}"><TextBlock Text="Tie-break order" Style="{StaticResource Heading}"/><CheckBox Content="Competition default" IsChecked="{Binding DefaultSorting}"/><StackPanel IsEnabled="{Binding SortingSupported}"><ListBox ItemsSource="{Binding Sorting}" SelectedItem="{Binding SelectedSort}" MaxHeight="150"/><WrapPanel Margin="0,8"><Button Content="Up" Click="Up" Margin="0,0,8,0"/><Button Content="Down" Click="Down" Margin="0,0,8,0"/><Button Content="Remove" Click="Remove"/></WrapPanel><ComboBox ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SortChoice}"/><Button Content="Add tie-break" Click="Add" HorizontalAlignment="Left" Margin="0,8"/></StackPanel></StackPanel>
 <StackPanel Visibility="{Binding ShowEndings,Converter={StaticResource Visible}}"><TextBlock Text="If a knockout tie is level" Style="{StaticResource Heading}"/><Expander Visibility="{Binding ShowSingle,Converter={StaticResource Visible}}" Header="Single-match ties" IsExpanded="True"><StackPanel Margin="10"><CheckBox Content="Competition default" IsChecked="{Binding DefaultSingle}"/><CheckBox Content="Extra time" IsChecked="{Binding SingleExtraTime}" Click="CustomizeEnding" Tag="Single" Margin="0,6"/><CheckBox Content="Penalty shoot-out" IsChecked="{Binding SinglePenalties}" Click="CustomizeEnding" Tag="Single"/></StackPanel></Expander><Expander Visibility="{Binding ShowTwo,Converter={StaticResource Visible}}" Header="Home-and-away ties" IsExpanded="False"><StackPanel Margin="10"><TextBlock Text="The first leg ends normally. The return leg decides the winner on aggregate." TextWrapping="Wrap" Margin="0,0,0,8"/><CheckBox Content="Competition default" IsChecked="{Binding DefaultTwo}"/><CheckBox Content="Extra time after the return leg" IsChecked="{Binding TwoExtraTime}" Click="CustomizeEnding" Tag="Two" Margin="0,6"/><CheckBox Content="Penalty shoot-out" IsChecked="{Binding TwoPenalties}" Click="CustomizeEnding" Tag="Two"/><CheckBox Content="Away-goal rule" IsChecked="{Binding AwayGoals}" Click="CustomizeEnding" Tag="Two" Margin="0,6"/><CheckBox Content="Away-goal rule after extra time" IsChecked="{Binding ExtraTimeAwayGoals}" Click="CustomizeEnding" Tag="Two"/></StackPanel></Expander></StackPanel>
 </StackPanel>
</UserControl>
