<UserControl x:Class="ATLink.Views.CompetitionStudio" FocusVisualStyle="{x:Null}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ATLink.Views" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource BackgroundBrush}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries>
 <Style TargetType="DatePickerTextBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource PanelBrush}"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
 <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,8,0,12"/></Style>
 <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,10"/></Style>
 <Style x:Key="Problem" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,8"/></Style>
 <DataTemplate x:Key="TeamTemplate"><StackPanel Orientation="Horizontal"><Image Source="{Binding Crest}" Width="30" Height="30" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel></DataTemplate>
 <DataTemplate x:Key="SlotTemplate"><StackPanel Margin="4"><TextBlock Text="{Binding DateLabel}" Foreground="{DynamicResource MutedBrush}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Kind}" FontWeight="Bold"/><TextBlock Text="{Binding TimeLabel, StringFormat=' · {0}'}" Margin="8,0"/></StackPanel><TextBlock Text="{Binding Phase}"/><TextBlock Text="{Binding Matchup}" TextWrapping="Wrap"/><TextBlock Text="{Binding Round, StringFormat='Matchday {0}'}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="Shared calendar" Foreground="{DynamicResource AccentBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Shared}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate>
 </ResourceDictionary></UserControl.Resources>
 <Grid><DockPanel IsEnabled="{Binding IsIdle}">
 <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Padding="16,12"><DockPanel><WrapPanel x:Name="ProjectActions" DockPanel.Dock="Right"><Button Content="Back" Click="BackClick" Margin="3"/><Button Content="Open project" Click="OpenProjectClick" Margin="3"/><Button Content="Export project" Click="ExportClick" Background="{DynamicResource AccentBrush}" Margin="3"/></WrapPanel><StackPanel><TextBlock Text="Competition studio" FontSize="22" FontWeight="Bold"/><TextBlock Text="{Binding Game}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DockPanel></Border>
 <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="16,8"/>
 <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <DockPanel Margin="0,0,16,0"><TextBlock DockPanel.Dock="Top" Text="Find a competition" Style="{StaticResource Heading}"/><TextBox DockPanel.Dock="Top" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Margin="0" ToolTip="Search competitions by name"/><Button x:Name="AddCompetition" DockPanel.Dock="Top" Content="Add competition" Click="CreateClick" Margin="0,20,0,20"/><ListBox x:Name="CompetitionList" ItemsSource="{Binding Competitions}" SelectedItem="{Binding Selected}" DisplayMemberPath="DisplayName" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"/></DockPanel>
 <DockPanel Grid.Column="1"><StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="{Binding Title}" FontSize="27" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="{Binding Region}" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
 <TabControl x:Name="Sections">
 <TabItem Header="Overview"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="At a glance" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Overview}" TextWrapping="Wrap"/><TextBlock Text="Competition name" Margin="0,18,0,6"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/><StackPanel Orientation="Horizontal" Margin="0,8"><Button Content="Apply name" Click="RenameClick" Margin="0,0,8,0"/><Button x:Name="CompetitionTranslations" Content="Translations" Click="TranslationsClick"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></StackPanel></Border><local:CompetitionLogoOverview DataContext="{Binding FootballFormat.Artwork}"/><local:CompetitionArtworkEditor DataContext="{Binding FootballFormat.Artwork}" Margin="0,0,0,12"/><TextBlock Text="How teams enter" Style="{StaticResource Heading}"/><ItemsControl ItemsSource="{Binding SportSources}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding ExportSummary}" Style="{StaticResource Hint}"/></StackPanel></ScrollViewer></TabItem>
 <TabItem Header="Teams"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14"><TextBlock Text="Participants" Style="{StaticResource Heading}"/><TextBlock Text="Teams are shown once. Participants selected through a league or another competition stay linked to that selection rule." Style="{StaticResource Hint}"/>
 <ListBox x:Name="Seats" ItemsSource="{Binding Seats}" SelectedItem="{Binding SelectedSeat}" MaxHeight="260"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="4"><TextBlock DockPanel.Dock="Right" Text="{Binding Allocation}" Foreground="{DynamicResource MutedBrush}" Margin="12,0"/><Image Source="{Binding Crest}" Width="32" Height="32" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
 <TextBlock Text="Choose a club" Style="{StaticResource Heading}"/><TextBox Text="{Binding TeamSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search club names"/><ListBox x:Name="TeamChoices" ItemsSource="{Binding AvailableTeams}" SelectedItem="{Binding ChosenTeam}" ItemTemplate="{StaticResource TeamTemplate}" Height="200" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/><WrapPanel Margin="0,10"><Button Content="Assign to selected place" Click="AssignClick" Margin="0,0,8,0"/><Button Content="To be determined" Click="ClearTeamClick"/></WrapPanel>
 <TextBlock Text="Add a named participant" Style="{StaticResource Heading}"/><ComboBox ItemsSource="{Binding SourceTargets}" SelectedItem="{Binding SourceTarget}" DisplayMemberPath="DisplayName"/><Button Content="Add chosen club to this group" Click="AddTeamClick" HorizontalAlignment="Left" Margin="0,10"/><TextBlock Text="{Binding TeamError}" Style="{StaticResource Problem}"/>
 </StackPanel></ScrollViewer></TabItem>
 <TabItem Header="Format &amp; qualification"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14"><local:FootballFormatEditor DataContext="{Binding FootballFormat}"/>
<TextBlock Text="Places &amp; qualification" Style="{StaticResource Heading}"/><TextBlock Text="Positions are labelled automatically from the configured sporting rules. This is a format preview, not live standings." Style="{StaticResource Hint}"/>
<WrapPanel Margin="0,0,0,12"><TextBlock Text="● Champion   " Foreground="#BC9FFF"/><TextBlock Text="● Qualification   " Foreground="#B399E3"/><TextBlock Text="● Promotion   " Foreground="#74C99B"/><TextBlock Text="● Playoff   " Foreground="#E0BD6F"/><TextBlock Text="● Relegation" Foreground="#E38DA6"/></WrapPanel>
<ItemsControl ItemsSource="{Binding StandingPlaces}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid ItemsSource="{Binding Places}" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="360"><DataGrid.Columns><DataGridTextColumn Header="Place" Binding="{Binding Position}" Width="65"/><DataGridTemplateColumn Header="Outcome" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="4" Background="{Binding Color}" Padding="8,4" Margin="2"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Category}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Outcome}" TextWrapping="Wrap"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></ScrollViewer></TabItem>
 <TabItem Header="Calendar"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14"><Border Style="{StaticResource Card}"><StackPanel><Expander Header="Illustrative calendar — choose a reference season"><StackPanel><TextBlock Text="These dates illustrate relative scheduling. They are not confirmed FC27 match dates. A slot is a possible time, not necessarily an assigned fixture. INT markers show projected shared dates for linked qualifiers. The editable event list shows the underlying file entries. You can move the whole matchday while keeping its other kick-off times." Style="{StaticResource Hint}"/><WrapPanel><TextBlock Text="Day zero" VerticalAlignment="Center" Margin="0,0,10,0"/><DatePicker SelectedDate="{Binding ReferenceDate}" Width="160"/><CheckBox Content="I understand this reference is illustrative" IsChecked="{Binding ReferenceConfirmed}" Margin="15,0" VerticalAlignment="Center"/></WrapPanel></StackPanel></Expander></StackPanel></Border>
 <DockPanel Margin="0,8,0,10"><Button DockPanel.Dock="Left" Content="‹" Click="PreviousMonth"/><Button DockPanel.Dock="Right" Content="›" Click="NextMonth"/><TextBlock Text="{Binding MonthTitle}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/></DockPanel><ComboBox ItemsSource="{Binding CalendarPhases}" SelectedItem="{Binding CalendarPhase}" DisplayMemberPath="DisplayName" Margin="0,0,0,10"/>
 <UniformGrid Columns="7"><TextBlock Text="Mon"/><TextBlock Text="Tue"/><TextBlock Text="Wed"/><TextBlock Text="Thu"/><TextBlock Text="Fri"/><TextBlock Text="Sat"/><TextBlock Text="Sun"/></UniformGrid>
 <ItemsControl x:Name="MonthDays" ItemsSource="{Binding Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Click="DayClick" Padding="5" Margin="2" MinHeight="70" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Opacity="{Binding Opacity}" ToolTip="{Binding Date,StringFormat='{}{0:dddd, d MMMM yyyy}'}"><StackPanel><TextBlock Text="{Binding Day}" FontWeight="Bold"/><TextBlock Text="{Binding Caption}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding InternationalMarker}" Foreground="#EABA36" FontSize="10" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Stages}" FontSize="10" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <WrapPanel Margin="0,10"><Button Content="New time slot" Click="NewSlotClick" Margin="0,0,8,0"/><Button Content="Remove selected event" Click="RemoveSlotClick"/></WrapPanel><TextBlock Text="{Binding SelectedDayTitle}" Style="{StaticResource Heading}"/><ItemsControl ItemsSource="{Binding DayInternationalEntries}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Description}" Foreground="#EABA36" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ListBox ItemsSource="{Binding DayEvents}" SelectedItem="{Binding ChosenSlot}" ItemTemplate="{StaticResource SlotTemplate}" MaxHeight="200"/>
 <Expander Header="All matchdays and time slots" Margin="0,12"><ListBox ItemsSource="{Binding Matchdays}" SelectedItem="{Binding ChosenSlot}" ItemTemplate="{StaticResource SlotTemplate}" Height="220" MouseDoubleClick="JumpSlot"/></Expander>
 <Border Style="{StaticResource Card}" IsEnabled="{Binding HasChosenSlot}"><StackPanel><TextBlock Text="Edit selected slot or fixture" Style="{StaticResource Heading}"/><TextBlock Text="Date"/><DatePicker SelectedDate="{Binding SlotDate}"/><TextBlock Text="Matchday number" Margin="0,8,0,4"/><TextBox IsEnabled="{Binding IsRelativeSlot}" Text="{Binding SlotRound,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Time (HH:mm or HHmm)" Margin="0,8,0,4"/><TextBox Text="{Binding SlotTime,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Stage" Margin="0,8,0,4"/><ComboBox IsEnabled="{Binding IsRelativeSlot}" ItemsSource="{Binding SlotPhaseChoices}" SelectedItem="{Binding SlotPhase}" DisplayMemberPath="DisplayName"/><WrapPanel IsEnabled="{Binding IsRelativeSlot}" Margin="0,8"><StackPanel Width="180" Margin="0,0,10,0"><TextBlock Text="Minimum matches"/><TextBox Text="{Binding SlotMin,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Width="180"><TextBlock Text="Maximum matches"/><TextBox Text="{Binding SlotMax,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></WrapPanel><CheckBox Content="Move every slot of this matchday to the new date (keep other kick-off times)" IsChecked="{Binding MoveWholeDay}" Margin="0,8"/><CheckBox Content="I confirm changes to this shared calendar affect its other users" IsChecked="{Binding SharedConsent}"/><Button Content="Apply slot changes" Click="SaveSlotClick" HorizontalAlignment="Left" Margin="0,12"/><TextBlock Text="{Binding CalendarError}" Style="{StaticResource Problem}"/></StackPanel></Border>
 </StackPanel></ScrollViewer></TabItem>
 <TabItem Header="Rules"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14"><TextBlock Text="Rules for" Style="{StaticResource Heading}"/><ComboBox ItemsSource="{Binding RuleScopes}" SelectedItem="{Binding RuleScope}" DisplayMemberPath="DisplayName"/><TextBlock Text="Use the competition defaults, or customize the rules for one played phase." Style="{StaticResource Hint}"/><local:FootballRulesPanel DataContext="{Binding SportRules}"/><Button Content="Apply rules" Click="RulesClick" HorizontalAlignment="Left" Margin="0,14"/><TextBlock Text="{Binding RulesError}" Style="{StaticResource Problem}"/></StackPanel></ScrollViewer></TabItem>
 <TabItem Header="Settings"><TabControl x:Name="SettingsSections"><TabItem Header="Phase options"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><local:FootballSettingsPanel DataContext="{Binding FootballFormat}" Edited="ApplyPhaseSettings"/><TextBlock Text="{Binding RulesError}" Style="{StaticResource Problem}" Margin="14,0"/></StackPanel></ScrollViewer></TabItem><TabItem Header="Season behaviour"><ScrollViewer VerticalScrollBarVisibility="Auto"><local:FootballSeasonEditor DataContext="{Binding Season}"/></ScrollViewer></TabItem></TabControl></TabItem>
 <TabItem x:Name="LinkedCompetitionsTab" Header="Linked competitions"><TabItem.Style><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Style.Triggers><DataTrigger Binding="{Binding Game}" Value="FC26"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TabItem.Style><local:FootballLinksEditor DataContext="{Binding Links}"/></TabItem>
 <TabItem Header="Expert"><DockPanel Margin="14"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button Content="Technical configuration" Click="TechnicalClick" Margin="0,0,8,0"/><Button Content="Duplicate an existing competition" Click="DuplicateClick"/></WrapPanel><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Expert files: unknown settings and raw IDs are preserved here. Apply validates the edited file before adding it to the draft." Style="{StaticResource Hint}"/><ComboBox Grid.Row="1" ItemsSource="{Binding AdvancedFiles}" SelectedItem="{Binding AdvancedFile}" Margin="0,8"/><TextBox Grid.Row="2" Text="{Binding AdvancedText,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/><Button Grid.Row="3" Content="Apply expert edit" Click="AdvancedClick" HorizontalAlignment="Left" Margin="0,10"/></Grid></DockPanel></TabItem>
 </TabControl></DockPanel></Grid></DockPanel><Border Background="{DynamicResource LoadingOverlayBrush}"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsWorking}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Border Style="{StaticResource Card}" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="{Binding WorkMessage}" TextWrapping="Wrap" Margin="0,0,0,18"/><ProgressBar IsIndeterminate="True" Height="6" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border></Border></Grid>
</UserControl>
