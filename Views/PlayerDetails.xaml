<UserControl x:Class="ATLink.Views.PlayerDetails"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:ATLink.Views"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="760"
 Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries>
   <views:RatingBrushConverter x:Key="RatingBrushConverter"/>
   <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,14,0,14"/>
   </Style>
   <Style x:Key="Divider" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="Margin" Value="0,10,0,0"/>
   </Style>
   <Style x:Key="Attribute" TargetType="ContentControl">
    <Setter Property="Margin" Value="0,3,10,3"/>
    <Setter Property="Template"><Setter.Value>
     <ControlTemplate TargetType="ContentControl">
      <DockPanel>
       <Border DockPanel.Dock="Right" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RatingBrushConverter}}" CornerRadius="4" Padding="6,3">
        <TextBlock Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
       </Border>
       <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap"/>
      </DockPanel>
     </ControlTemplate>
    </Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <!-- Panel frame and scrolling -->
 <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
         BorderThickness="1" CornerRadius="10" Padding="18">
  <Grid>
   <TextBlock Text="No players found" FontSize="20" FontWeight="SemiBold">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
     <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
    </Style></TextBlock.Style>
   </TextBlock>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers>
     <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    </Style.Triggers></Style></ScrollViewer.Style>
    <StackPanel>
     <!-- Portrait and player identity -->
     <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0">
       <Border Width="115" Height="145" Background="#4D000000"
               BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Image Source="{Binding Portrait}" Stretch="UniformToFill" HorizontalAlignment="Center"/>
       </Border>
       <TextBlock Text="{Binding Id, StringFormat=({0})}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                  HorizontalAlignment="Center" Margin="0,5,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,2,12,0">
       <WrapPanel>
        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </WrapPanel>
       <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
        <views:FlagImage Source="{Binding Flag}" Width="22" Height="20"  Margin="0,0,8,0"/>
        <TextBlock Text="{Binding Nationality}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
       </StackPanel>
       <TextBlock Text="{Binding PositionDescription}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
       <TextBlock Text="{Binding AgeAndBirthDate}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
       <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
       <TextBlock Text="Market value" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
       <TextBlock Text="{Binding ContractText}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Top">
      <Border MinWidth="48" MinHeight="48" Padding="10,4" VerticalAlignment="Top"
              Background="{Binding Overall, Converter={StaticResource RatingBrushConverter}}" CornerRadius="8" Margin="10">
       <TextBlock Text="{Binding Overall}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
      </Border>
       <Border Width="45" Height="40" HorizontalAlignment="Center" Background="Transparent"
               Visibility="{Binding HasClub, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding ClubName}">
        <Image Source="{Binding ClubCrest}" Stretch="Uniform"/>
       </Border>
      </StackPanel>
     </Grid>
     <Border Style="{StaticResource Divider}"/>
     <TextBlock Text="Overview" Style="{StaticResource SectionTitle}"/>
     <!-- Characteristics and preferred positions -->
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="Characteristics" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding [height], StringFormat=Height   {0} cm}"/>
       <TextBlock Text="{Binding [weight], StringFormat=Weight   {0} kg}"/>
       <TextBlock Text="{Binding Birth, StringFormat=Birth date   {0:dd MMM yyyy}, TargetNullValue=Birth date   —}" Language="en-US"/>
       <TextBlock Text="{Binding Nationality, StringFormat=Nationality   {0}}" TextWrapping="Wrap"/>
       <DockPanel Margin="0,3,10,0"><Border DockPanel.Dock="Right" Background="#FF3C3057" BorderBrush="#FFBCADD9" BorderThickness="1" CornerRadius="4" Padding="6,3"><TextBlock Text="{Binding Potential}" FontWeight="SemiBold" Foreground="#FFBCADD9"/></Border><TextBlock Text="Potential"/></DockPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="12,0,0,0">
       <TextBlock Text="Positions" FontSize="16" FontWeight="SemiBold"/>
       <ItemsControl ItemsSource="{Binding Positions}">
        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="16"/></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </Grid>
     <Border Style="{StaticResource Divider}"/>
     <TextBlock Text="Main attributes" Style="{StaticResource SectionTitle}"/>
     <!-- Change labels, bindings and row order here -->
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ContentControl Style="{StaticResource Attribute}" Content="Sprint speed" Tag="{Binding [sprintspeed]}"/>
      <ContentControl Grid.Row="1" Style="{StaticResource Attribute}" Content="Acceleration" Tag="{Binding [acceleration]}"/>
      <ContentControl Grid.Row="2" Style="{StaticResource Attribute}" Content="Finishing" Tag="{Binding [finishing]}"/>
      <ContentControl Grid.Row="3" Style="{StaticResource Attribute}" Content="Dribbling" Tag="{Binding [dribbling]}"/>
      <ContentControl Grid.Row="4" Style="{StaticResource Attribute}" Content="Ball control" Tag="{Binding [ballcontrol]}"/>
      <ContentControl Grid.Column="1" Style="{StaticResource Attribute}" Content="Short passing" Tag="{Binding [shortpassing]}"/>
      <ContentControl Grid.Column="1" Grid.Row="1" Style="{StaticResource Attribute}" Content="Vision" Tag="{Binding [vision]}"/>
      <ContentControl Grid.Column="1" Grid.Row="2" Style="{StaticResource Attribute}" Content="Reactions" Tag="{Binding [reactions]}"/>
      <ContentControl Grid.Column="1" Grid.Row="3" Style="{StaticResource Attribute}" Content="Stamina" Tag="{Binding [stamina]}"/>
      <ContentControl Grid.Column="1" Grid.Row="4" Style="{StaticResource Attribute}" Content="Strength" Tag="{Binding [strength]}"/>
     </Grid>
     <TextBlock Text="Values reflect the loaded database. Missing values are shown as —." FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,18" TextWrapping="Wrap"/>
     <Button Content="Edit player  →" Background="{DynamicResource AccentBrush}" Padding="16,12" Click="EditClick"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Border>
</UserControl>
