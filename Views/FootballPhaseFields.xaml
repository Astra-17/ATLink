<UserControl x:Class="ATLink.Views.FootballPhaseFields" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ATLink.Views"><UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/><Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,12,0,5"/><Setter Property="FontWeight" Value="SemiBold"/></Style></UserControl.Resources><StackPanel IsEnabled="{Binding Editable}"><TextBlock Text="Phase settings" FontSize="20" FontWeight="Bold"/><TextBlock Text="Name" Style="{StaticResource Label}"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/>
 <TextBlock Text="Format" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}"/>
 <WrapPanel><StackPanel Width="185" Margin="0,0,14,0"><TextBlock Text="Teams entering" Style="{StaticResource Label}"/><ComboBox IsEditable="False" ItemsSource="{Binding ParticipantChoices}" SelectedItem="{Binding Participants}" IsEnabled="{Binding CanChooseInput}"/></StackPanel><StackPanel Width="185" Visibility="{Binding IsGroups,Converter={StaticResource Visible}}"><TextBlock Text="Groups" Style="{StaticResource Label}"/><ComboBox IsEditable="False" ItemsSource="{Binding GroupChoices}" SelectedItem="{Binding Groups}"/></StackPanel></WrapPanel>
 <StackPanel Visibility="{Binding Tables,Converter={StaticResource Visible}}"><TextBlock Text="Qualifiers per group (0 for a final table)" Style="{StaticResource Label}"/><ComboBox IsEditable="False" ItemsSource="{Binding QualifierChoices}" SelectedItem="{Binding Qualifiers}"/></StackPanel>
 <StackPanel Visibility="{Binding Knockout,Converter={StaticResource Visible}}"><TextBlock Text="Number of knockout rounds" Style="{StaticResource Label}"/><ComboBox IsEditable="False" ItemsSource="{Binding RoundChoices}" SelectedItem="{Binding Rounds}"/></StackPanel>
 <TextBlock Text="Matches" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding LegOptions}" SelectedItem="{Binding Legs}"/>
 <StackPanel Visibility="{Binding Knockout,Converter={StaticResource Visible}}"><TextBlock Text="Final (when this phase reaches a winner)" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding LegOptions}" SelectedItem="{Binding FinalLegs}"/></StackPanel>
 <Expander Header="Keep points from the previous phase" Margin="0,12" Visibility="{Binding Tables,Converter={StaticResource Visible}}"><StackPanel><CheckBox Content="Carry points between compatible table phases" IsChecked="{Binding CarryPoints}"/><TextBlock Text="Percentage retained" Style="{StaticResource Label}"/><ComboBox IsEditable="False" ItemsSource="{Binding PercentageChoices}" SelectedItem="{Binding CarryPercentage}"/><TextBlock Text="Rounding" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding RoundingChoices}" SelectedItem="{Binding CarryRounding}"/></StackPanel></Expander>
 <local:FootballPhaseEssentials x:Name="Essentials" Margin="0,18,0,0"/></StackPanel></UserControl>