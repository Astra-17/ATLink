<UserControl xmlns:loc="clr-namespace:ATLink.Services" x:Class="ATLink.Views.FootballLinksEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ATLink.Views" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource BackgroundBrush}">
 <UserControl.Resources>
  <Style TargetType="DatePickerTextBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource PanelBrush}"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,16,0,8"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,5,0,10"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="18" IsEnabled="{Binding Supported}">
   <TextBlock Text="{loc:Text T6086681ccdcfb5}" FontSize="26" FontWeight="Bold"/>
   <TextBlock Text="{Binding Title}" FontSize="18" Margin="0,8,0,0"/>
   <TextBlock Text="{Binding ExistingLinks}" Style="{StaticResource Hint}" Margin="0,10"/>
   <Button Content="{loc:Text T9499587fecc98f}" Click="CreateCompetition" HorizontalAlignment="Left" Margin="0,0,0,14"/>
   <TabControl x:Name="Relations" SelectedIndex="{Binding Section,Mode=TwoWay}">
    <TabItem Header="{loc:Text Te899981a85a06c}">
     <StackPanel Margin="14">
      <TextBlock Text="{loc:Text T227eb5cc2b2557}" Style="{StaticResource Heading}"/>
      <ComboBox ItemsSource="{Binding NeighbourChoices}" SelectedItem="{Binding Upper}" DisplayMemberPath="Name" IsTextSearchEnabled="True" TextSearch.TextPath="Name"/>
      <TextBlock Text="{loc:Text T77097dfe565627}" Style="{StaticResource Heading}"/>
      <ComboBox ItemsSource="{Binding NeighbourChoices}" SelectedItem="{Binding Lower}" DisplayMemberPath="Name" IsTextSearchEnabled="True" TextSearch.TextPath="Name"/>
      <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding NativeDivision}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{loc:Text T66e0cb8e961c74}" Style="{StaticResource Heading}"/>
      <ComboBox ItemsSource="{Binding PromotionChoices}" SelectedItem="{Binding Promotion}" DisplayMemberPath="Name"/>
      </StackPanel>
      <TextBlock Text="{Binding DivisionHelp}" Style="{StaticResource Hint}"/>
      <TextBlock Text="{Binding NativePlaces}" Style="{StaticResource Hint}"/>
      <TextBlock Text="{loc:Text T3b547e31aa340d}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Hint}"><Style.Triggers><DataTrigger Binding="{Binding NativeDivision}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </StackPanel>
    </TabItem>
    <TabItem Header="{loc:Text Te0db2274873225}">
     <StackPanel Margin="14">
      <TextBlock Text="{loc:Text Td8dd15318984e5}" Style="{StaticResource Heading}"/>
      <ComboBox ItemsSource="{Binding Competitions}" SelectedItem="{Binding QualifierDestination}" DisplayMemberPath="Name" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"/>
      <TextBlock Text="{Binding QualifierStatus}" Style="{StaticResource Hint}"/>
      <TextBlock Text="{loc:Text Tf387028a3fa603}" Margin="0,8,0,5"/>
      <TextBox Text="{Binding QualifierName,UpdateSourceTrigger=PropertyChanged}"/><local:CompetitionArtworkEditor DataContext="{Binding QualifierArtwork}"/>
      <TextBlock Text="{loc:Text T347c2eb8d1ea3c}" Style="{StaticResource Heading}"/>
      <DockPanel><Button DockPanel.Dock="Right" Content="{loc:Text Tdc937b59892604}" Click="ClearExclusion" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding Competitions}" SelectedItem="{Binding ExcludedCompetition}" DisplayMemberPath="Name" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"/></DockPanel>
      <TextBlock Text="{loc:Text T7ee3a1d378efbc}" Style="{StaticResource Hint}"/>
      <local:FootballQuotaEditor x:Name="QualifierSettings"/>
     </StackPanel>
    </TabItem>
    <TabItem Header="{loc:Text T6a74063fd6423d}">
     <StackPanel Margin="14"><TextBlock Text="{loc:Text Tf7089dde71ba22}" Style="{StaticResource Heading}"/>
      <ComboBox ItemsSource="{Binding Competitions}" SelectedItem="{Binding CalendarSource}" DisplayMemberPath="Name" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"/>
      <CheckBox Content="{loc:Text Tb8d3915952a347}" IsChecked="{Binding UseSourceTime}" Margin="0,16"/>
      <TextBlock Text="{loc:Text Tc687833a03305c}" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding Times}" SelectedItem="{Binding CalendarKickoff}" IsEditable="True" Width="120" HorizontalAlignment="Left"/>
      <TextBlock Text="{loc:Text Tba34f07e1fef1e}" Style="{StaticResource Hint}"/>
     </StackPanel>
    </TabItem>
   </TabControl>
   <WrapPanel Margin="0,18,0,8"><Button Content="{loc:Text T330c32c49a13ad}" Click="Review" Margin="0,0,8,8"/><Button Content="{loc:Text Tbf140337f1f641}" Click="Reset" Margin="0,0,8,8"/></WrapPanel>
   <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><TextBlock Text="{Binding Preview}" TextWrapping="Wrap"/></Border>
   <CheckBox Content="{loc:Text T7e519634b4c980}" IsChecked="{Binding Confirmed}" Margin="0,14"/>
   <Button Content="{loc:Text T7457bfdcafd55d}" Click="Apply" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"/>
   <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,12"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>

