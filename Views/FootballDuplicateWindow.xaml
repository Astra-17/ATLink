<Window x:Class="ATLink.Views.FootballDuplicateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource {x:Type Window}}" Title="Duplicate competition" Width="650" Height="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/ATLink;component/Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
<DockPanel Margin="24" Background="{DynamicResource BackgroundBrush}"><StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,12"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="Cancel" Click="Cancel" Margin="4"/><Button Content="Create duplicate draft" Click="Confirm" Margin="4" Background="{DynamicResource AccentBrush}"/></StackPanel></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Duplicate competition" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,18"/><TextBlock Text="Competition name" Margin="0,0,0,6"/><TextBox x:Name="NewName"/><TextBlock Text="The full native structure, season tasks, initial standings and unrecognized settings are preserved. Known internal object references and the new league's statistics links are remapped. Custom unknown references need review in Expert. Clubs stay in their current domestic leagues. Resources and in-game registration still require verification." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,18"/></StackPanel></ScrollViewer></DockPanel></Window>