<Window x:Class="ATLink.Views.CalendarDayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ATLink.Views" Style="{x:Null}" WindowStyle="None" ResizeMode="NoResize" Title="Matchday" Width="760" Height="800" MinWidth="520" MinHeight="420" WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Template><ControlTemplate TargetType="Window"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><AdornerDecorator><ContentPresenter/></AdornerDecorator></Border></ControlTemplate></Window.Template><Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/ATLink;component/Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible"/><Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,12"/></Style></ResourceDictionary></Window.Resources>
 <DockPanel Margin="22" Background="{DynamicResource BackgroundBrush}"><StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Reference}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,12"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" MaxHeight="110" Margin="0,8"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Click="Cancel" Margin="4"/><Button Content="Apply" Click="Apply" IsEnabled="{Binding CanEdit}" Background="{DynamicResource AccentBrush}" Margin="4"/></StackPanel></StackPanel>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Other competitions" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding External}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="Bold"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}"/><ItemsControl ItemsSource="{Binding Teams}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,6"><Image Source="{Binding Crest}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Provenance}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <Border Style="{StaticResource Card}" BorderBrush="#EABA36" Visibility="{Binding HasOtherInternationalEntries,Converter={StaticResource Visible}}">
  <StackPanel><TextBlock Text="International calendar" FontSize="20" FontWeight="Bold" Foreground="#EABA36"/>
   <ItemsControl ItemsSource="{Binding OtherInternationalEntries}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
 </Border>
 <Border Style="{StaticResource Card}" BorderBrush="#EABA36" Visibility="{Binding HasFriendlySlots,Converter={StaticResource Visible}}"><StackPanel><TextBlock Text="International friendlies" FontSize="20" FontWeight="Bold" Foreground="#EABA36"/><TextBlock Text="Each entry represents an entire international friendly slot. Replacing it removes all scheduled friendly matches in that slot when the competition is created and exported. Add your competition matches below, then select the slots to replace." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10"/><ItemsControl ItemsSource="{Binding FriendlySlots}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap"/><CheckBox Content="Replace this entire slot" IsChecked="{Binding Replace}" IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,6"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><StackPanel IsEnabled="{Binding CanEdit}"><TextBlock Text="Your competition" FontSize="20" FontWeight="Bold" Margin="0,12"/><TextBlock Text="Phase"/><ComboBox ItemsSource="{Binding Phases}" SelectedItem="{Binding Phase}" DisplayMemberPath="Name"/><TextBlock Text="Matchday / leg" Margin="0,10,0,4"/><ComboBox ItemsSource="{Binding Rounds}" SelectedItem="{Binding Round}"/><TextBlock Text="Number of matches on this day" Margin="0,10,0,4"/><ComboBox ItemsSource="{Binding Counts}" SelectedItem="{Binding Count}"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><CheckBox Content="Fixed hours" IsChecked="{Binding FixedHours}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding FixedTimeChoices}" SelectedItem="{Binding FixedTime}" IsEnabled="{Binding CanEditFixedTime}"/></Grid><TextBlock Text="Suggested matches may be moved from their suggested date. Manually fixed matches elsewhere are kept. Removing a match here leaves it unplaced until you reschedule it." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,16"/>
 <ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Phase}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Kick-off" Margin="0,12,0,4"/><ComboBox ItemsSource="{Binding Times}" SelectedItem="{Binding Time}" IsEnabled="{Binding CanEditTime}"/><TextBlock Text="Stadium" Margin="0,12,0,4"/><StackPanel Visibility="{Binding HasTieVenue,Converter={StaticResource Visible}}"><local:FootballTieVenueEditor DataContext="{Binding TieVenue}"/></StackPanel><TextBox Text="{Binding Venue,Mode=OneWay}" IsReadOnly="True" IsEnabled="False" Visibility="{Binding NoTieVenue,Converter={StaticResource Visible}}"/><TextBlock Text="{Binding Conflict}" TextWrapping="Wrap" Foreground="#EABA36" Margin="0,8"/><TextBlock Visibility="{Binding NoTieVenue,Converter={StaticResource Visible}}" Text="{Binding VenueNote}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></StackPanel></ScrollViewer></DockPanel>
</Window>
